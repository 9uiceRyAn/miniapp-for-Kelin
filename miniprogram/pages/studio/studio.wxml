<view class="device-nav workspace-shell" style="{{navigationStyle}}">
  <button hover-class="motion-pressed" hover-stay-time="70" class="drawer-button {{drawerOpen?'is-behind':''}}" bindtap="toggleDrawer" aria-expanded="{{drawerOpen}}" aria-hidden="{{drawerOpen}}" aria-label="打开侧栏"><view class="ws-ico ws-ico-menu"/></button>
  <include src="../../templates/workspace-sidebar.wxml"/>
  <view class="workspace-main">
    <view class="workspace-header">
      <view class="header-start"><button hover-class="motion-pressed" hover-stay-time="70" class="header-back" bindtap="back" aria-label="返回"><view class="ws-ico ws-ico-back"/></button><text>AI Agent 预设管理</text></view>
    </view>
    <view class="workspace-content">
      <view class="ws-toolbar-primary">
        <button hover-class="motion-pressed" hover-stay-time="70" class="ws-btn ws-btn-primary" bindtap="openCreate">＋ 新建助手</button>
      </view>
    <text class="subpage-subtitle">只需填写名称、简介、一段话 Prompt、工具权限与可用范围；保存即对选定范围生效。</text>

    <view class="ws-segment" style="margin-bottom: 16px;">
      <button class="ws-segment-item {{onlyMine?'':'is-selected'}}" data-mine="0" bindtap="switchScope">全部助手</button>
      <button class="ws-segment-item {{onlyMine?'is-selected':''}}" data-mine="1" bindtap="switchScope">我创建的</button>
    </view>

    <view class="ws-list" wx:if="{{items.length}}">
      <view wx:for="{{items}}" wx:key="id" class="ws-list-row">
        <view class="ws-list-main">
          <view class="ws-list-title-row">
            <text class="ws-list-title">{{item.name}}</text>
            <text wx:if="{{item.pinned}}" class="ws-badge ws-badge-success">置顶</text>
            <text class="ws-badge {{item.enabled?'ws-badge-default':'ws-badge-danger'}}">{{item.enabled?'已启用':'已停用'}}</text>
          </view>
          <text wx:if="{{item.description}}" class="ws-list-meta">{{item.description}}</text>
          <view class="ws-badge-row">
            <text class="ws-badge ws-badge-default">{{item.tool_permission==='read_write'?'可改':'只读'}}</text>
            <text class="ws-badge {{item.audience==='teacher_only'?'ws-badge-draft':'ws-badge-default'}}">{{item.audience==='teacher_only'?'仅教师可用':'所有人可用'}}</text>
            <text wx:if="{{item.teacherName}}" class="ws-badge ws-badge-default">{{item.teacherName}}</text>
          </view>
        </view>
        <view class="ws-list-actions">
          <button hover-class="motion-pressed" hover-stay-time="70" class="ws-btn ws-btn-secondary ws-btn-sm" data-id="{{item.id}}" bindtap="openEdit">编辑</button>
          <button hover-class="motion-pressed" hover-stay-time="70" class="ws-btn ws-btn-secondary ws-btn-sm" data-index="{{index}}" bindtap="openMenu" aria-label="更多操作">⋯</button>
        </view>
      </view>
    </view>
    <view wx:elif="{{loading}}" class="ws-empty">正在读取助手列表…</view>
    <view wx:else class="ws-empty">暂无助手，点击上方「＋ 新建助手」创建</view>
    </view>
  </view>
  <include src="../../templates/workspace-bottom.wxml"/>

  <!-- 5 项极简编辑抽屉 -->
  <block wx:if="{{sheetOpen}}">
    <view class="ws-overlay" bindtap="closeSheet"/>
    <view class="ws-sheet" role="dialog" aria-label="{{editingId?'编辑助手':'新建助手'}}">
      <view class="ws-sheet-header">
        <view>
          <text class="ws-sheet-title">{{editingId?'编辑教学助手':'新建教学助手'}}</text>
          <text class="ws-sheet-subtitle">配置助手角色、工具权限与可见范围</text>
        </view>
        <button class="ws-sheet-close" bindtap="closeSheet" disabled="{{saving}}" aria-label="关闭"><view class="ws-ico ws-ico-close ws-ico-sm"/></button>
      </view>
      <scroll-view scroll-y class="ws-sheet-body">
        <text class="ws-field-label">名称</text>
        <input
          class="ws-input"
          value="{{form.name}}"
          data-field="name"
          bindinput="formInput"
          maxlength="191"
          placeholder="例如：数学答疑助教"
          placeholder-class="ws-placeholder"
        />

        <text class="ws-field-label">简介（选填）</text>
        <input
          class="ws-input"
          value="{{form.description}}"
          data-field="description"
          bindinput="formInput"
          maxlength="300"
          placeholder="一句话说明助手用途"
          placeholder-class="ws-placeholder"
        />

        <text class="ws-field-label">Prompt（一段话指令）</text>
        <textarea
          class="ws-textarea"
          style="min-height: 160px;"
          value="{{form.content}}"
          data-field="content"
          bindinput="formInput"
          maxlength="-1"
          placeholder="描述助手的角色定位、回答风格和注意事项…"
          placeholder-class="ws-placeholder"
        />

        <text class="ws-field-label">工具权限</text>
        <view class="ws-segment">
          <button class="ws-segment-item {{form.toolPermission==='read_only'?'is-selected':''}}" data-field="toolPermission" data-value="read_only" bindtap="formSelect">只读（仅查资料与题库）</button>
          <button class="ws-segment-item {{form.toolPermission==='read_write'?'is-selected':''}}" data-field="toolPermission" data-value="read_write" bindtap="formSelect">可改（仅对教师生效）</button>
        </view>

        <text class="ws-field-label">可用范围</text>
        <view class="ws-segment">
          <button class="ws-segment-item {{form.audience==='all'?'is-selected':''}}" data-field="audience" data-value="all" bindtap="formSelect">所有人可用</button>
          <button class="ws-segment-item {{form.audience==='teacher_only'?'is-selected':''}}" data-field="audience" data-value="teacher_only" bindtap="formSelect">仅教师可用</button>
        </view>

        <view wx:if="{{formError}}" class="ws-error-box">{{formError}}</view>
        <view class="ws-sheet-spacer"/>
      </scroll-view>
      <view class="ws-sheet-footer">
        <button hover-class="motion-pressed" hover-stay-time="70" class="ws-btn ws-btn-secondary" bindtap="closeSheet" disabled="{{saving}}">取消</button>
        <button hover-class="motion-pressed" hover-stay-time="70" class="ws-btn ws-btn-primary" bindtap="save" loading="{{saving}}" disabled="{{saving||!form.name||!form.content}}">保存</button>
      </view>
    </view>
  </block>
</view>
