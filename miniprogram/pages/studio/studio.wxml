<view class="device-nav learning-page" style="{{navigationStyle}}"><view class="nav"><text class="back" bindtap="back">‹ 返回</text><text>教师工作台</text></view><text class="title">创建与管理教学助手</text><text class="sub">草稿修改不影响已发布版本和已有会话。</text><view class="actions"><button hover-class="motion-pressed" hover-stay-time="70" class="primary" bindtap="builder" loading="{{openingBuilder}}" disabled="{{openingBuilder||saving||!editorReady}}">与创建助手一起编写</button><button hover-class="motion-pressed" hover-stay-time="70" bindtap="material" disabled="{{!editorReady}}">添加公共教学资料</button></view><view class="card" wx:if="{{editorReady}}"><text class="label">名称</text><input value="{{name}}" data-field="name" bindinput="input"/><text class="label">教学用途</text><textarea value="{{description}}" data-field="description" bindinput="input"/><text class="label">教学指令</text><textarea value="{{content}}" data-field="content" bindinput="input" maxlength="-1"/><text class="label">工具使用说明</text><textarea value="{{toolInstructions}}" data-field="toolInstructions" bindinput="input"/><text class="label">教学模型</text><picker range="{{models}}" range-key="name" value="{{modelIndex}}" bindchange="model"><view class="picker">{{models[modelIndex].name||'请先由管理员配置模型'}}</view></picker><view wx:for="{{references}}" wx:key="resourceId" class="row"><text class="grow">{{item.title||item.resourceId}}</text><button hover-class="motion-pressed" hover-stay-time="70" data-index="{{index}}" bindtap="removeReference">移除引用</button></view><view class="actions"><button hover-class="motion-pressed" hover-stay-time="70" bindtap="save" loading="{{saving}}" disabled="{{saving||openingBuilder}}">保存草稿</button><button hover-class="motion-pressed" hover-stay-time="70" bindtap="trial" disabled="{{saving||openingBuilder}}">试聊当前草稿</button><button hover-class="motion-pressed" hover-stay-time="70" class="primary" bindtap="publish" disabled="{{saving||openingBuilder}}">发布新版本</button><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{status==='published'}}" bindtap="unpublish">下架</button></view><text class="sub">当前状态：{{status}}。试聊固定启动时的草稿；发布后所有已登录学生均可使用。</text></view><view class="actions"><button hover-class="motion-pressed" hover-stay-time="70" bindtap="records">学生会话与作业</button><button hover-class="motion-pressed" hover-stay-time="70" bindtap="costs">使用与费用</button></view></view>
