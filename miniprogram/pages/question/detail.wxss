@import "../../styles/learning.wxss";
@import "../../styles/workspace-tokens.wxss";
@import "../../styles/workspace-layout.wxss";
@import "../../styles/workspace-content.wxss";
@import "../../styles/workspace-motion.wxss";
.workspace-detail-shell{grid-template-columns:minmax(0,1fr)}
.question-detail-shell{grid-template-rows:minmax(0,1fr) auto}
.question-detail-page{max-width:860px;margin:0 auto;padding:0 32px 36px;box-sizing:border-box;animation:workspace-enter 200ms ease-out both}
.detail-nav{height:72px;display:flex;align-items:center;gap:18px;font-size:12px;color:var(--ws-secondary);padding-right:100px}
.workspace-shell .detail-back{padding:10px 0;font-size:13px;background:transparent;white-space:nowrap}
.detail-brand{margin-left:auto;font-size:10px;letter-spacing:1.2px;color:var(--ws-tertiary)}
.detail-heading{padding:24px 0 27px;border-bottom:1px solid var(--ws-border);margin-bottom:24px}
.detail-paper{display:flex;align-items:center;gap:12px;flex-wrap:wrap;color:var(--ws-secondary);font-size:12px;line-height:1.7}
.detail-subject{font-weight:500;color:var(--ws-text)}
.detail-title{display:block;font-size:26px;line-height:1.4;font-weight:600;letter-spacing:-.4px;margin-top:12px;overflow-wrap:anywhere}
.detail-topic{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-top:10px;font-size:12px;line-height:1.7;color:#6f6f6f}.detail-topic-label{min-width:0;overflow-wrap:anywhere}.detail-quality{font-size:10px;padding:2px 7px;background:#f7f3e8;color:#8a6b2c;border-radius:5px}
.detail-section-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}.detail-section-title{font-size:13px;font-weight:500;display:block;line-height:1.7}.detail-image-hint{font-size:11px;color:#6f6f6f}
.detail-reading{margin:0 0 26px}.detail-image-sheet{margin:0 0 18px;overflow:hidden;border:1px solid var(--ws-border);border-radius:12px;background:#fff}.detail-question-image{display:block;width:100%;height:auto}.detail-image-caption{display:block;padding:12px 14px 0;font-size:11px;color:var(--ws-secondary)}
.detail-document-text{font-size:14px;line-height:1.9;margin:0 0 30px}.detail-paragraph{display:block;white-space:pre-wrap;overflow-wrap:anywhere;margin:12px 0 24px}.detail-associated,.detail-audio{padding:20px 0;border-bottom:1px solid var(--ws-border);font-size:13px}.detail-associated button{margin-top:12px}
.detail-information{margin-top:30px;border-top:1px solid var(--ws-border)}.workspace-shell .detail-disclosure{width:100%;display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--ws-secondary);padding:17px 0;background:transparent}.detail-disclosure-arrow{font-size:17px;transition:transform 180ms ease}.detail-disclosure-arrow.is-open{transform:rotate(180deg)}.detail-information-body{padding:0 0 20px;animation:workspace-enter 180ms ease-out both}.detail-info-label{display:block;font-size:10px;color:var(--ws-tertiary);margin:12px 0 5px}.detail-info-value{display:block;font-size:12px;color:var(--ws-secondary);line-height:1.8;overflow-wrap:anywhere}.detail-information-body button{margin-top:16px}
.detail-question-actions{background:var(--ws-canvas);border-top:1px solid var(--ws-border);padding-bottom:env(safe-area-inset-bottom);z-index:20}.detail-question-actions-inner{max-width:860px;margin:auto;padding:13px 32px;display:flex;gap:12px;align-items:center;box-sizing:border-box}
.workspace-shell .detail-answer-button{min-width:122px;min-height:46px;border:1px solid var(--ws-border);background:var(--ws-canvas);border-radius:12px;text-align:center;padding:12px 18px;font-size:13px;color:var(--ws-secondary)}
.workspace-shell .detail-ask-button{flex:1;min-height:46px;display:flex;align-items:center;justify-content:center;gap:15px;background:var(--ws-accent);color:var(--ws-on-accent);font-size:14px;font-weight:500;border-radius:12px;padding:12px 20px;text-align:center}.detail-ask-arrow{font-size:20px;font-weight:400}
.detail-tutor-scrim{position:absolute;inset:0;background:#00000055;z-index:40;animation:workspace-backdrop 160ms ease both}.detail-tutor-sheet{position:absolute;bottom:0;left:0;right:0;background:var(--ws-canvas);border-radius:22px 22px 0 0;z-index:41;padding:0 24px calc(22px + env(safe-area-inset-bottom));max-height:85%;overflow:auto;animation:question-sheet-enter 240ms cubic-bezier(.22,1,.36,1) both;box-sizing:border-box}.detail-tutor-inner{max-width:540px;margin:auto}.detail-sheet-handle{width:32px;height:4px;background:var(--ws-border);border-radius:4px;margin:10px auto 18px}.detail-tutor-title{font-size:20px;font-weight:600}.workspace-shell .detail-sheet-close{background:var(--ws-muted);width:44px;height:44px;min-height:44px;flex-shrink:0;border-radius:50%;padding:0;text-align:center;line-height:44px;font-size:22px;color:var(--ws-secondary)}.detail-tutor-description{display:block;color:var(--ws-secondary);font-size:12px;line-height:1.8;margin:0 0 20px}
.detail-selected-tutor{display:flex;align-items:center;gap:12px;padding:16px 0 20px}.detail-tutor-symbol{height:38px;width:38px;background:var(--ws-muted);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:23px}.detail-selected-name{font-size:14px;display:block;font-weight:500}.detail-selected-caption{display:block;font-size:11px;color:var(--ws-tertiary);margin-top:5px}.detail-tutor-picker{display:flex;align-items:center;justify-content:space-between;padding:14px;border:1px solid var(--ws-border);border-radius:12px;margin:16px 0 24px;font-size:14px}
.detail-sheet-actions{display:flex;gap:10px;align-items:center;margin:4px 0 14px}.workspace-shell .detail-existing-button{font-size:12px;padding:12px 14px;background:var(--ws-muted);border-radius:12px;text-align:center;min-height:46px;white-space:nowrap}.detail-existing-list{max-height:210px;border-top:1px solid var(--ws-border);margin-top:12px}.workspace-shell .detail-existing-row{width:100%;display:flex;justify-content:space-between;align-items:center;font-size:12px;gap:10px;border-bottom:1px solid var(--ws-border);padding:15px 0;border-radius:0}.detail-existing-row text:nth-child(2){font-size:10px;color:var(--ws-tertiary)}
@keyframes question-sheet-enter{from{opacity:.5;transform:translateY(35px)}to{opacity:1;transform:translateY(0)}}@keyframes workspace-backdrop{from{opacity:0}to{opacity:1}}
@media(max-width:700px){.question-detail-page{padding:0 18px 28px}.detail-nav{height:64px;gap:16px;padding-right:96px}.detail-brand{display:none}.detail-heading{padding:15px 0 20px;margin-bottom:21px}.detail-title{font-size:24px;margin-top:10px}.detail-paper{font-size:12px;gap:10px}.detail-topic{font-size:11px;margin-top:8px}.detail-question-actions-inner{padding:12px 18px;gap:10px}.workspace-shell .detail-answer-button{min-width:108px;font-size:12px}.workspace-shell .detail-ask-button{font-size:13px}.detail-tutor-sheet{padding-left:22px;padding-right:22px}}
@media(min-width:900px){.detail-tutor-sheet{max-width:620px;left:50%;right:auto;width:100%;transform:translateX(-50%);animation:question-sheet-enter-wide 240ms cubic-bezier(.22,1,.36,1) both}.question-detail-page{padding-top:10px}.detail-title{font-size:28px}}
@keyframes question-sheet-enter-wide{from{opacity:.5;transform:translate(-50%,35px)}to{opacity:1;transform:translate(-50%,0)}}
@media(prefers-reduced-motion:reduce){.question-detail-page,.detail-information-body,.detail-tutor-sheet,.detail-tutor-scrim{animation:none}.detail-disclosure-arrow{transition:none}}

.detail-question-text{padding:4px 0 25px}.detail-question-text .detail-paragraph{white-space:pre-wrap;line-height:1.9;margin-top:14px}
