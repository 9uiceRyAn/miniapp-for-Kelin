<view class="workspace-shell workspace-detail-shell"><view class="workspace-main"><view class="learning-page"><view class="nav"><text class="back" bindtap="back">‹ 返回列表</text><text>COLLINS</text></view><view wx:if="{{loading}}" class="empty">正在读取…</view><text wx:if="{{error}}" class="error">{{error}}</text><block wx:if="{{item}}"><text class="title">{{item.title}}</text><text class="sub">{{item.subtitle}}</text><view class="card"><text class="badge">{{item.subject_label||'教学资料'}}</text><text class="badge">{{item.primary_tag_name||item.status}}</text><text wx:if="{{item.review_required}}" class="badge">待审核</text><text wx:if="{{item.release_status==='provisional'}}" class="badge">暂定发布</text><text class="sub">来源：{{item.sourceText}}</text><text class="sub">资料修订：{{item.revisionId}}</text><text wx:if="{{item.parseError}}" class="error">{{item.parseError}}</text><text wx:if="{{item.status==='queued'||item.status==='processing'}}" class="status">正在解析，完成后自动更新…</text><view wx:for="{{item.chunks}}" wx:key="position"><text class="label">{{item.label}}</text><text class="sub">{{item.body}}</text></view></view><view class="actions"><button wx:if="{{!document}}" class="primary" bindtap="ask">用教学助手讲解</button><button wx:if="{{!document}}" bindtap="toggleAnswers">{{answers?'收起答案材料':'查看答案材料'}}</button><button wx:if="{{original.available}}" bindtap="openOriginal">查看原文件</button><button wx:if="{{canManage}}" bindtap="replace">上传新修订</button><button wx:if="{{canRetry&&item.status!=='ready'}}" bindtap="retry">重试解析</button><button wx:if="{{canManage}}" class="danger" bindtap="withdraw">撤下公共资料</button></view><view wx:if="{{!document&&!item.hasAnswer}}" class="sub">暂无答案材料</view><view wx:if="{{choosing}}" class="card"><text class="card-title">选择教学助手</text><picker range="{{tutors}}" range-key="name" value="{{tutorIndex}}" bindchange="tutor"><view class="picker">{{tutors[tutorIndex].name||'暂无已发布助手'}}</view></picker><view class="actions"><button class="primary" bindtap="newConversation">开启新会话</button><button bindtap="chooseExisting">选择已有会话</button></view><button wx:for="{{existing}}" wx:key="id" data-id="{{item.id}}" bindtap="existing">继续 {{item.updated_at}}</button><text wx:if="{{existing.length===0}}" class="sub">可以开启新会话，或选择该助手已有的会话。</text></view><view wx:for="{{images}}" wx:key="id" class="card" wx:if="{{answers||!item.answer}}"><text class="label">{{item.label}}</text><image wx:if="{{item.available}}" class="full-image" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" bindtap="preview" data-id="{{item.id}}" binderror="imageError"/><text wx:else class="error">此材料暂不可用</text></view><view wx:for="{{otherMedia}}" wx:key="id" class="card"><text class="label">{{item.label}} · {{item.kind}}</text><button wx:if="{{item.available}}" data-index="{{index}}" bindtap="openOther">读取关联材料</button><text wx:else class="error">此材料暂不可用</text></view><view wx:for="{{audio}}" wx:key="id" class="card"><text class="card-title">{{item.label}}</text><button wx:if="{{item.available}}" data-index="{{index}}" bindtap="play">{{audioIndex===index&&playing?'暂停':'播放音频'}}</button><text wx:else class="error">音频暂不可用</text><block wx:if="{{audioIndex===index}}"><slider min="0" max="{{duration||1}}" value="{{current}}" bindchange="seek" activeColor="#9b1f58"/><text class="sub">{{current}} / {{duration}} 秒</text></block></view></block></view></view><include src="../../templates/workspace-bottom.wxml"/></view>