<view class="device-nav workspace-shell workspace-detail-shell {{document?'document-detail-shell':'question-detail-shell'}}" style="{{navigationStyle}}">
 <view class="workspace-main">
  <view class="question-detail-page">
   <view class="detail-nav"><button hover-class="motion-pressed" hover-stay-time="70" class="detail-back" bindtap="back" aria-label="返回列表">‹ 返回</button><text>{{document?'教学资料':'题目详情'}}</text><text class="detail-brand">COLLINS</text></view>
   <view wx:if="{{loading}}" class="empty">正在读取…</view><text wx:if="{{error}}" class="error">{{error}}</text>
   <block wx:if="{{item}}">
    <view class="detail-heading">
     <view class="detail-paper"><text class="detail-subject">{{item.subject_label||'教学资料'}}</text><text>{{paperSummary}}</text></view>
     <text class="detail-title">{{questionHeading}}</text>
     <view class="detail-topic"><text class="detail-topic-label" wx:if="{{topicLabel}}">{{topicLabel}}</text><text wx:if="{{item.review_required}}" class="detail-quality">待审核</text><text wx:if="{{item.release_status==='provisional'}}" class="detail-quality">暂定发布</text></view>
    </view>
    <view wx:if="{{item.parseError}}" class="error">{{item.parseError}}</view><view wx:if="{{item.status==='queued'||item.status==='processing'}}" class="status">正在解析，完成后自动更新…</view>
    <view wx:if="{{document&&item.chunks.length}}" class="detail-document-text"><view wx:for="{{item.chunks}}" wx:key="position"><text class="detail-section-title">{{item.label}}</text><text class="detail-paragraph" user-select="{{true}}">{{item.body}}</text></view></view>
    <view wx:if="{{!document&&(answers?item.answer_text:item.question_text)}}" class="detail-question-text"><text class="detail-section-title">{{answers?'参考答案':'题目'}}</text><text class="detail-paragraph" user-select="{{true}}">{{answers?item.answer_text:item.question_text}}</text></view>
    <view class="detail-reading" wx:if="{{visibleImages.length}}">
     <view class="detail-section-heading"><text class="detail-section-title">{{document?'资料内容':answers?'参考答案':'题目'}}</text><text class="detail-image-hint">点按图片放大</text></view>
     <view wx:for="{{visibleImages}}" wx:key="id" class="detail-image-sheet"><text wx:if="{{visibleImages.length>1}}" class="detail-image-caption">{{item.label}}</text><image wx:if="{{item.available}}" class="detail-question-image" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" data-id="{{item.id}}" bindtap="preview" binderror="imageError" aria-label="{{item.label}}，点按放大"/><text wx:else class="error">此材料暂不可用</text></view>
    </view>
    <view wx:for="{{visibleOtherMedia}}" wx:key="id" class="detail-associated"><text class="detail-section-title">{{item.label}}</text><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{item.available}}" data-index="{{item.originalIndex}}" bindtap="openOther">读取关联材料 ↗</button><text wx:else class="error">此材料暂不可用</text></view>
    <view wx:if="{{!answers}}"><view wx:for="{{audio}}" wx:key="id" class="detail-audio"><view class="detail-section-heading"><text class="detail-section-title">{{item.label}}</text><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{item.available}}" data-index="{{index}}" bindtap="play">{{audioIndex===index&&playing?'暂停':'播放音频'}}</button></view><text wx:if="{{!item.available}}" class="error">音频暂不可用</text><block wx:if="{{audioIndex===index}}"><slider min="0" max="{{duration||1}}" value="{{current}}" bindchange="seek" activeColor="#242424"/><text class="sub">{{current}} / {{duration}} 秒</text></block></view></view>
    <view class="detail-information">
     <button hover-class="motion-pressed" hover-stay-time="70" class="detail-disclosure" bindtap="toggleDetails" aria-expanded="{{detailsOpen}}"><text>来源与{{document?'资料':'题目'}}信息</text><text class="detail-disclosure-arrow {{detailsOpen?'is-open':''}}">⌄</text></button>
     <view wx:if="{{detailsOpen}}" class="detail-information-body"><text class="detail-info-label">来源</text><text class="detail-info-value" user-select="{{true}}">{{item.sourceText}}</text><block wx:if="{{item.sourceId||item.id}}"><text class="detail-info-label">{{document?'资料':'题目'}}编号</text><text class="detail-info-value" user-select="{{true}}">{{item.sourceId||item.id}}</text></block><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{original.available}}" bindtap="openOriginal">查看原文件 ↗</button></view>
    </view>
    <view wx:if="{{document&&(canManage||canRetry)}}" class="detail-manage actions"><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{canManage}}" bindtap="replace">上传新修订</button><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{canRetry&&item.status!=='ready'}}" bindtap="retry">重试解析</button><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{canManage}}" class="danger" bindtap="withdraw">撤下公共资料</button></view>
   </block>
  </view>
 </view>
 <view wx:if="{{item&&!document}}" class="detail-question-actions"><view class="detail-question-actions-inner"><button hover-class="motion-pressed" hover-stay-time="70" class="detail-answer-button" bindtap="toggleAnswers" disabled="{{!item.hasAnswer}}">{{item.hasAnswer?(answers?'返回题目':'查看答案'):'暂无答案'}}</button><button hover-class="motion-pressed" hover-stay-time="70" class="detail-ask-button" bindtap="ask" loading="{{loadingTutors}}" disabled="{{loadingTutors}}"><text>带题提问</text><text class="detail-ask-arrow">↗</text></button></view></view>
 <block wx:if="{{document}}"><include src="../../templates/workspace-bottom.wxml"/></block>
 <view wx:if="{{choosing}}" class="detail-tutor-scrim" bindtap="closeTutor"/>
 <view wx:if="{{choosing}}" class="detail-tutor-sheet">
  <view class="detail-tutor-inner"><view class="detail-sheet-handle"/><view class="detail-section-heading"><text class="detail-tutor-title">带题提问</text><button hover-class="motion-pressed" hover-stay-time="70" class="detail-sheet-close" bindtap="closeTutor" aria-label="关闭助手选择">×</button></view><text class="detail-tutor-description">{{questionHeading}}将带入对话，可以继续追问解题思路。</text>
   <text wx:if="{{loadingTutors}}" class="status">正在读取教学助手…</text>
   <block wx:else><view wx:if="{{tutors.length===1}}" class="detail-selected-tutor"><view class="detail-tutor-symbol">✧</view><view><text class="detail-selected-name">{{tutors[0].name}}</text><text class="detail-selected-caption">当前教学助手</text></view></view><picker wx:elif="{{tutors.length>1}}" range="{{tutors}}" range-key="name" value="{{tutorIndex}}" bindchange="tutor"><view class="detail-tutor-picker">{{tutors[tutorIndex].name}} <text>⌄</text></view></picker><text wx:else class="detail-tutor-description">暂无已发布的教学助手，请联系教师。</text>
   <view class="detail-sheet-actions"><button hover-class="motion-pressed" hover-stay-time="70" class="detail-ask-button" bindtap="newConversation" loading="{{startingConversation}}" disabled="{{!tutors.length||startingConversation}}">开始新对话 ↗</button><button hover-class="motion-pressed" hover-stay-time="70" class="detail-existing-button" bindtap="chooseExisting" loading="{{existingLoading}}" disabled="{{!tutors.length||startingConversation||existingLoading}}" wx:if="{{!existingLoaded}}">继续已有对话</button></view>
   <scroll-view wx:if="{{existing.length}}" class="detail-existing-list" scroll-y="{{true}}"><button hover-class="motion-pressed" hover-stay-time="70" wx:for="{{existing}}" wx:key="id" class="detail-existing-row" data-id="{{item.id}}" bindtap="existing"><text>学习对话</text><text>{{item.updated_at}}</text><text>›</text></button></scroll-view><text wx:elif="{{existingLoaded}}" class="detail-tutor-description">还没有该助手的会话，可以开始新对话。</text><button wx:if="{{existingHasMore}}" class="detail-existing-button" loading="{{existingLoading}}" disabled="{{existingLoading}}" bindtap="chooseExisting">加载更多会话</button></block>
  </view>
 </view>
 <image-zoom wx:if="{{previewOpen}}" images="{{previewImages}}" initial-index="{{previewIndex}}" bindclose="closePreview"/>
</view>
