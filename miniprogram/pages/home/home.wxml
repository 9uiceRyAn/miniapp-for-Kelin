<view class="workspace-shell management-shell" style="--ws-safe-top:{{safeTop}}px">
 <button wx:if="{{!drawerOpen}}" hover-class="motion-pressed" hover-stay-time="70" class="drawer-button" bindtap="toggleDrawer" aria-expanded="{{drawerOpen}}" aria-label="打开侧栏">☰</button>
 <include src="../../templates/workspace-sidebar.wxml"/>
 <view class="workspace-main">
  <view class="workspace-header"><view class="header-start"><text>题库管理</text></view></view>
  <view class="workspace-content management-content">
   <button class="manage-back" bindtap="back">‹ 返回个人中心</button>
   
   <view class="heading-row"><text class="workspace-title">题库管理</text><view wx:if="{{admin}}" class="manage-actions"><button class="manage-import" bindtap="importQuestions" loading="{{importBusy}}" disabled="{{importBusy}}">导入题库</button><button class="manage-primary manage-new" bindtap="newQuestion">＋ 新建题目</button></view></view>
   <text class="workspace-subtitle">维护题目、知识点与发布状态</text>
   <view wx:if="{{checking}}" class="manage-empty">正在验证管理权限…</view>
   <view wx:elif="{{!admin}}" class="manage-empty">仅管理员可管理题库</view>
   <block wx:else>
    <text class="manage-import-hint">支持上传题目与答案图片、PDF、音频；批量导入支持 JSON 或 ZIP，每包最多 1000 道题目。</text>
    <view class="workspace-search"><input data-hint-id="hint0" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" value="{{q}}" bindinput="searchInput" bindconfirm="search" placeholder="{{inputHintFocus==='hint0'?'':'搜索题目、原题编号或知识点'}}" confirm-type="search"/><button bindtap="search" aria-label="搜索题目">搜索</button></view>
    <view class="manage-filters">
     <picker range="{{subjects}}" range-key="label" value="{{subjectIndex}}" data-field="subjectIndex" bindchange="filter"><view class="manage-filter">{{subjects[subjectIndex].label}}<text>⌄</text></view></picker>
     <picker range="{{collections}}" range-key="label" value="{{collectionIndex}}" data-field="collectionIndex" bindchange="filter"><view class="manage-filter">{{collections[collectionIndex].label}}<text>⌄</text></view></picker>
     <picker range="{{states}}" range-key="label" value="{{stateIndex}}" data-field="stateIndex" bindchange="filter"><view class="manage-filter">{{states[stateIndex].label}}<text>⌄</text></view></picker>
     <view class="manage-review-filter"><text>待审核</text><switch checked="{{reviewRequired}}" bindchange="review" color="#242424"/></view>
    </view>
    <text wx:if="{{error}}" class="error">{{error}}</text>
    <text wx:if="{{importResult}}" class="manage-import-result">{{importResult}}</text>
    <view class="results-summary"><text>共 {{total}} 道题目</text><text>编辑会保留历史修订</text></view>
    <view class="manage-list">
     <view wx:for="{{items}}" wx:key="resourceId" class="manage-row">
      <view class="manage-row-main" data-id="{{item.resourceId}}" bindtap="openQuestion">
       <image wx:if="{{item.thumbnailUrl}}" class="manage-thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFit"/>
       <view class="manage-row-copy"><text class="manage-title">{{item.title}}</text><text class="manage-meta">{{item.subject_label}} · {{item.collection_label}}</text><text class="manage-topic" wx:if="{{item.primary_tag_name}}">{{item.primary_tag_name}}</text><view class="manage-badges"><text class="manage-state state-{{item.release_status}}">{{item.stateLabel}}</text><text wx:if="{{item.review_required}}" class="manage-review-badge">待审核</text></view></view>
      </view>
      <view class="manage-row-actions"><button wx:if="{{item.visibility==='withdrawn'}}" class="manage-restore" data-id="{{item.resourceId}}" bindtap="restoreQuestion">恢复题目</button><block wx:else><button class="manage-edit" data-id="{{item.resourceId}}" bindtap="editQuestion">编辑</button><button class="manage-delete" data-id="{{item.resourceId}}" bindtap="deleteQuestion">删除</button></block></view>
     </view>
    </view>
    <view wx:if="{{loading}}" class="manage-empty">正在读取题目…</view><view wx:elif="{{!items.length}}" class="manage-empty">当前条件下暂无题目</view>
    <button wx:if="{{total > items.length}}" class="manage-more" bindtap="more" loading="{{loading}}">加载更多题目</button>
   </block>
  </view>
 </view>
 <include src="../../templates/workspace-bottom.wxml"/>
 <block wx:if="{{formOpen}}">
  <view class="manage-overlay" bindtap="closeForm"/>
  <view class="manage-sheet" role="dialog" aria-label="{{editingId?'编辑题目':'新建题目'}}">
   <view class="manage-sheet-header"><view><text class="manage-sheet-title">{{editingId?'编辑题目':'新建题目'}}</text><text class="manage-sheet-subtitle">题干可填写文字，也可上传图片或 PDF</text></view><button class="manage-sheet-close" bindtap="closeForm" disabled="{{saving||uploading}}" aria-label="关闭编辑">×</button></view>
   <scroll-view scroll-y class="manage-sheet-body">
    <text class="manage-field-label">题目标题</text><input data-hint-id="hint1" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" class="manage-input" value="{{form.title}}" data-field="title" bindinput="formInput" maxlength="1000" placeholder="{{inputHintFocus==='hint1'?'':'例如：2025 数学 Paper 1 · 第 3 题'}}"/>
    <view class="manage-form-grid">
     <view><text class="manage-field-label">学科</text><picker range="{{formSubjects}}" range-key="label" value="{{formSubjectIndex}}" data-field="formSubjectIndex" bindchange="formPick" disabled="{{!!editingId}}"><view class="manage-input manage-picker">{{formSubjects[formSubjectIndex].label}}<text wx:if="{{!editingId}}">⌄</text></view></picker></view>
     <view><text class="manage-field-label">数据集</text><picker range="{{formCollections}}" range-key="label" value="{{formCollectionIndex}}" data-field="formCollectionIndex" bindchange="formPick" disabled="{{!!editingId}}"><view class="manage-input manage-picker">{{formCollections[formCollectionIndex].label}}<text wx:if="{{!editingId}}">⌄</text></view></picker></view>
    </view>
    <block wx:if="{{!editingId}}"><text class="manage-field-label">原题编号（选填）</text><input data-hint-id="hint2" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" class="manage-input" value="{{form.sourceId}}" data-field="sourceId" bindinput="formInput" maxlength="191" placeholder="{{inputHintFocus==='hint2'?'':'留空则自动生成'}}"/></block>
    <text class="manage-field-label">知识点标签</text><textarea data-hint-id="hint3" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" class="manage-textarea manage-tags-input" value="{{form.tagsText}}" data-field="tagsText" bindinput="formInput" maxlength="30000" placeholder="{{inputHintFocus==='hint3'?'':'每行一个：编号 | 名称，例如 1.1 | 二次函数'}}"/>
    <text class="manage-field-label">题干</text><textarea data-hint-id="hint4" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" class="manage-textarea" value="{{form.questionText}}" data-field="questionText" bindinput="formInput" maxlength="100000" placeholder="{{inputHintFocus==='hint4'?'':'输入题目文字，或在下方上传题目图片／PDF'}}"/>
    <text class="manage-field-label">参考答案（选填）</text><textarea data-hint-id="hint5" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" class="manage-textarea" value="{{form.answerText}}" data-field="answerText" bindinput="formInput" maxlength="100000" placeholder="{{inputHintFocus==='hint5'?'':'输入答案或评分要点'}}"/>
    <view class="manage-attachment-heading"><text class="manage-field-label">题目与答案文件</text><text wx:if="{{uploading}}">正在上传…</text></view>
    <view class="manage-attachment-actions"><button data-kind="question" bindtap="addAttachment" disabled="{{saving||uploading}}">＋ 题目</button><button data-kind="answer" bindtap="addAttachment" disabled="{{saving||uploading}}">＋ 答案</button><button data-kind="source" bindtap="addAttachment" disabled="{{saving||uploading}}">＋ 附件／音频</button></view>
    <view wx:for="{{form.attachments}}" wx:key="key" class="manage-attachment"><view class="manage-attachment-name" data-index="{{index}}" bindtap="previewAttachment"><text>{{item.kindLabel}}</text><text>{{item.label}}</text><text wx:if="{{item.available===false}}" class="error">原文件不可用</text></view><button data-index="{{index}}" bindtap="removeAttachment" disabled="{{saving||uploading}}" aria-label="移除文件">×</button></view>
    <view class="manage-form-grid manage-publish-fields"><view><text class="manage-field-label">发布状态</text><picker range="{{releases}}" range-key="label" value="{{releaseIndex}}" data-field="releaseIndex" bindchange="formPick"><view class="manage-input manage-picker">{{releases[releaseIndex].label}}<text>⌄</text></view></picker></view><view class="manage-review-control"><text>待审核</text><switch checked="{{form.reviewRequired}}" bindchange="formReview" color="#242424"/></view></view>
    <text wx:if="{{formError}}" class="error manage-form-error">{{formError}}</text><view class="manage-sheet-spacer"/>
   </scroll-view>
   <view class="manage-sheet-footer"><button class="manage-cancel" bindtap="closeForm" disabled="{{saving||uploading}}">取消</button><button class="manage-primary manage-save" bindtap="saveQuestion" loading="{{saving}}" disabled="{{saving||uploading}}">保存题目</button></view>
  </view>
 </block>
 <block wx:if="{{importPreview}}">
  <view class="manage-overlay" bindtap="cancelImport"/>
  <view class="manage-sheet manage-import-sheet" role="dialog" aria-label="导入预览">
   <view class="manage-sheet-header"><view><text class="manage-sheet-title">导入预览</text><text class="manage-sheet-subtitle">{{importPreview.name}}</text></view><button class="manage-sheet-close" bindtap="cancelImport" disabled="{{importBusy}}" aria-label="取消导入">×</button></view>
   <scroll-view scroll-y class="manage-sheet-body">
    <view class="manage-import-stats"><view><text>{{importPreview.summary.items}}</text><text>题目总数</text></view><view><text>{{importPreview.summary.created}}</text><text>新增题目</text></view><view><text>{{importPreview.summary.updated}}</text><text>更新题目</text></view><view><text>{{importPreview.summary.unchanged}}</text><text>内容相同</text></view></view>
    <text class="manage-import-description">已检查 {{importPreview.summary.media}} 个媒体文件。确认后按清单中的发布状态导入。</text>
    <text class="manage-import-description">已发布 {{importPreview.summary.published}} 道 · 草稿 {{importPreview.summary.drafts}} 道 · 暂定发布 {{importPreview.summary.provisional}} 道</text>
    <text class="manage-field-label">题目预览</text><view wx:for="{{importPreview.samples}}" wx:key="key" class="manage-import-sample"><text>{{item.title}}</text><text>{{item.collection}} · {{item.sourceId}}</text></view>
    <text wx:if="{{error}}" class="error manage-form-error">{{error}}</text><view class="manage-sheet-spacer"/>
   </scroll-view>
   <view class="manage-sheet-footer"><button class="manage-cancel" bindtap="cancelImport" disabled="{{importBusy}}">取消</button><button class="manage-primary manage-confirm-import" bindtap="confirmImport" loading="{{importBusy}}" disabled="{{importBusy}}">确认导入</button></view>
  </view>
 </block>
</view>
