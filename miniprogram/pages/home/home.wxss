@import "../../styles/workspace-tokens.wxss";
@import "../../styles/workspace-layout.wxss";
@import "../../styles/workspace-content.wxss";
@import "../../styles/workspace-motion.wxss";
.management-content{max-width:1100px;padding-bottom:50px}.workspace-shell .manage-back{padding:0;margin-bottom:28px;color:var(--ws-secondary);font-size:12px}.manage-actions{display:flex;align-items:center;gap:10px;flex-shrink:0}.workspace-shell .manage-actions button{font-size:12px;white-space:nowrap;border:1px solid var(--ws-border);padding:10px 14px}.workspace-shell .manage-primary{background:var(--ws-accent);color:var(--ws-on-accent);text-align:center;font-weight:500}.manage-import-hint{display:block;font-size:11px;line-height:1.9;color:var(--ws-secondary);margin:17px 0 0}.manage-filters{display:grid;grid-template-columns:1fr 1.6fr 1fr auto;gap:10px;margin-bottom:24px;align-items:center}.manage-filters picker{min-width:0}.manage-filter{display:flex;justify-content:space-between;gap:10px;align-items:center;border:1px solid var(--ws-border);border-radius:10px;padding:11px 12px;font-size:12px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.manage-filter text{color:var(--ws-tertiary)}.manage-review-filter{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--ws-secondary);white-space:nowrap}.manage-review-filter switch{transform:scale(.65);transform-origin:right center;margin-left:-10px}.manage-import-result{display:block;padding:14px 16px;background:var(--ws-sidebar);border-radius:10px;font-size:12px;line-height:1.8;margin-bottom:14px}.manage-list{border-top:1px solid var(--ws-border)}.manage-row{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--ws-border);padding:21px 0;align-items:center}.manage-row-main{display:flex;align-items:center;gap:17px;min-width:0;flex:1}.manage-thumbnail{width:68px;height:80px;flex-shrink:0;border:1px solid var(--ws-border);border-radius:9px;background:var(--ws-sidebar)}.manage-row-copy{min-width:0;flex:1}.manage-title{display:block;font-size:14px;font-weight:500;line-height:1.6;overflow-wrap:anywhere}.manage-meta,.manage-topic{display:block;font-size:11px;line-height:1.8;color:var(--ws-secondary);margin-top:5px}.manage-topic{color:var(--ws-text);margin-top:3px}.manage-badges{display:flex;align-items:center;gap:7px;margin-top:10px}.manage-state,.manage-review-badge{font-size:10px;padding:3px 7px;border-radius:5px;background:var(--ws-muted);color:var(--ws-secondary)}.manage-state.state-draft{color:#79714f;background:#f5f1e6}.manage-review-badge{background:transparent;color:#887440}.manage-row-actions{display:flex;gap:8px;align-items:center;flex-shrink:0}.workspace-shell .manage-row-actions button{padding:8px 11px;font-size:11px;border:1px solid var(--ws-border);border-radius:8px}.workspace-shell .manage-row-actions .manage-delete{border-color:transparent;color:var(--ws-danger)}.manage-empty{padding:38px 0;text-align:center;font-size:13px;color:var(--ws-secondary)}.workspace-shell .manage-more{display:block;border:1px solid var(--ws-border);margin:24px auto 0;padding:11px 20px;font-size:12px}.management-shell .error{display:block;color:var(--ws-danger);font-size:12px;line-height:1.8;padding:8px 0;overflow-wrap:anywhere}.manage-overlay{position:fixed;inset:0;background:#00000045;z-index:40}.manage-sheet{position:fixed;z-index:41;right:0;top:0;bottom:0;width:640px;max-width:100%;background:var(--ws-canvas);display:flex;flex-direction:column;box-shadow:-8px 0 40px #00000012;animation:workspace-enter 180ms ease-out both}.manage-sheet-header{padding:calc(var(--ws-safe-top, 0px) + 52px) 28px 20px;display:flex;align-items:flex-start;justify-content:space-between;gap:16px;border-bottom:1px solid var(--ws-border);flex-shrink:0}.manage-sheet-title{display:block;font-size:21px;font-weight:600}.manage-sheet-subtitle{display:block;color:var(--ws-secondary);font-size:11px;line-height:1.8;margin-top:7px;overflow-wrap:anywhere}.workspace-shell .manage-sheet-close{padding:0;width:32px;height:32px;min-height:32px;border-radius:50%;background:var(--ws-muted);font-size:23px;line-height:1;display:flex;align-items:center;justify-content:center;flex-shrink:0}.manage-sheet-body{min-height:0;flex:1;height:0;padding:0 28px;box-sizing:border-box}.manage-field-label{display:block;font-size:11px;font-weight:500;color:var(--ws-secondary);margin:21px 0 9px}.manage-input,.manage-textarea{width:100%;border:1px solid var(--ws-border);background:var(--ws-canvas);border-radius:10px;font-family:var(--ws-font);font-size:13px;color:var(--ws-text);padding:12px;box-sizing:border-box}.manage-input{height:45px}.manage-textarea{height:140px;line-height:1.8}.manage-tags-input{height:90px}.manage-picker{display:flex;justify-content:space-between;align-items:center;gap:9px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:12px}.manage-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.manage-form-grid>view{min-width:0}.manage-review-control{display:flex;align-items:center;justify-content:flex-end;gap:10px;font-size:12px;padding-top:29px}.manage-review-control switch{transform:scale(.75);transform-origin:right center}.manage-attachment-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}.manage-attachment-heading>text:last-child{font-size:10px;color:var(--ws-secondary)}.manage-attachment-actions{display:flex;gap:8px;flex-wrap:wrap}.workspace-shell .manage-attachment-actions button{border:1px solid var(--ws-border);font-size:11px;padding:9px 12px}.manage-attachment{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 0;border-bottom:1px solid var(--ws-border)}.manage-attachment-name{min-width:0;flex:1}.manage-attachment-name text{display:block;font-size:11px;color:var(--ws-secondary);line-height:1.8;overflow-wrap:anywhere}.manage-attachment-name text:nth-child(2){font-size:12px;color:var(--ws-text)}.workspace-shell .manage-attachment>button{font-size:20px;flex-shrink:0;padding:5px 9px}.manage-sheet-footer{display:flex;justify-content:flex-end;align-items:center;gap:12px;padding:18px 28px calc(18px + env(safe-area-inset-bottom));border-top:1px solid var(--ws-border);flex-shrink:0}.workspace-shell .manage-sheet-footer button{min-height:44px;padding:11px 22px;font-size:13px}.workspace-shell .manage-cancel{border:1px solid var(--ws-border);text-align:center}.manage-form-error{margin-top:12px}.manage-sheet-spacer{height:24px}.manage-import-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:24px 0}.manage-import-stats text{display:block;font-size:11px;color:var(--ws-secondary);margin-top:8px}.manage-import-stats text:first-child{font-size:25px;color:var(--ws-text);font-weight:500;margin:0}.manage-import-description{font-size:12px;line-height:1.8;color:var(--ws-secondary);display:block;margin-bottom:15px}.manage-import-sample{padding:14px 0;border-bottom:1px solid var(--ws-border)}.manage-import-sample text{display:block;font-size:13px;line-height:1.7;overflow-wrap:anywhere}.manage-import-sample text:last-child{font-size:10px;color:var(--ws-secondary);margin-top:5px}
@media(max-width:700px){.management-content .heading-row{align-items:flex-start;flex-direction:column;gap:17px}.manage-actions{width:100%}.workspace-shell .manage-actions button{flex:1;text-align:center;padding:11px 9px}.manage-filters{grid-template-columns:1fr 1fr}.manage-filters picker:nth-child(2){grid-column:2;grid-row:1}.manage-review-filter{justify-content:flex-end}.manage-row{align-items:flex-start;gap:10px;flex-wrap:wrap;padding:20px 0}.manage-row-main{width:100%;flex:auto}.manage-thumbnail{width:55px;height:68px}.manage-row-actions{margin:4px 0 0 auto}.management-content .results-summary{font-size:10px}.manage-sheet{top:calc(var(--ws-safe-top, 0px) + 48px);bottom:0;border-radius:20px 20px 0 0;width:100%;max-height:calc(100% - var(--ws-safe-top, 0px) - 48px);animation:workspace-enter 180ms ease-out both}.manage-sheet-header{padding:21px 20px 16px}.manage-sheet-title{font-size:20px}.manage-sheet-subtitle{max-width:210px}.manage-sheet-body{padding:0 20px}.manage-sheet-footer{padding-left:20px;padding-right:20px}.manage-sheet-footer .manage-primary{flex:1}.manage-form-grid{grid-template-columns:1fr}.manage-publish-fields{grid-template-columns:1fr 1fr}.manage-review-control{padding-top:28px}.manage-input{font-size:12px}.manage-import-stats{gap:6px}.manage-import-stats text:first-child{font-size:23px}}
@media(prefers-reduced-motion:reduce){.manage-sheet{animation:none}}

@media(max-width:700px){.management-shell .header-account{display:none}}
