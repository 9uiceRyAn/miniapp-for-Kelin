@import "../../styles/workspace-layout.wxss";
@import "../../styles/workspace-content.wxss";
@import "../../styles/workspace-components.wxss";

.batch-bar{position:sticky;bottom:16px;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;padding:12px 16px;margin-top:16px;background:var(--ws-canvas);border:1px solid var(--ws-accent);border-radius:var(--ws-radius);box-shadow:0 6px 24px #00000014}
.batch-bar-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.tag-chips{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 10px}
.tag-chip{font-size:11px;padding:4px 10px;border-radius:6px;border:1px solid var(--ws-border);background:var(--ws-sidebar);color:var(--ws-text)}
.tag-chip.is-selected{background:var(--ws-accent);color:var(--ws-on-accent);border-color:var(--ws-accent)}
.management-content{max-width:1100px;padding-bottom:50px}
.manage-filters{display:grid;grid-template-columns:1fr 1.6fr 1fr;gap:10px;margin-bottom:20px;align-items:center}
.manage-filters picker{min-width:0}
.manage-import-result{display:block;padding:14px 16px;background:var(--ws-sidebar);border-radius:var(--ws-radius);font-size:12px;line-height:1.8;margin-bottom:14px}
.manage-row-main{display:flex;align-items:center;gap:14px;min-width:0;flex:1}
.manage-thumbnail{width:64px;height:76px;flex-shrink:0;border:1px solid var(--ws-border);border-radius:var(--ws-radius-sm);background:var(--ws-sidebar)}
.manage-topic{display:block;font-size:12px;line-height:1.6;color:var(--ws-text);margin-top:3px}
.manage-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.manage-form-grid>view{min-width:0}
.manage-tags-input{min-height:84px;height:90px}
.manage-attachment-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:16px}
.manage-attachment-heading .ws-field-label{margin:0}
.manage-attachment-heading>text:last-child{font-size:11px;color:var(--ws-secondary)}
.manage-attachment-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.manage-attachment{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 0;border-bottom:1px solid var(--ws-border)}
.manage-attachment-name{min-width:0;flex:1}
.manage-attachment-name text{display:block;font-size:11px;color:var(--ws-secondary);line-height:1.7;overflow-wrap:anywhere}
.manage-attachment-name text:nth-child(2){font-size:13px;color:var(--ws-text)}
.manage-import-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:20px 0}
.manage-import-stats text{display:block;font-size:11px;color:var(--ws-secondary);margin-top:6px}
.manage-import-stats text:first-child{font-size:24px;color:var(--ws-text);font-weight:500;margin:0}
.manage-import-description{font-size:12px;line-height:1.8;color:var(--ws-secondary);display:block;margin-bottom:14px}
.manage-import-sample{padding:14px 0;border-bottom:1px solid var(--ws-border)}
.manage-import-sample text{display:block;font-size:13px;line-height:1.7;overflow-wrap:anywhere}
.manage-import-sample text:last-child{font-size:11px;color:var(--ws-secondary);margin-top:4px}
@media(max-width:700px){
  .manage-filters{grid-template-columns:1fr 1fr}
  .manage-filters picker:nth-child(2){grid-column:2;grid-row:1}
  .manage-row-main{width:100%;flex:auto}
  .manage-thumbnail{width:54px;height:66px}
  .manage-form-grid{grid-template-columns:1fr}
  .manage-import-stats{gap:6px}
  .manage-import-stats text:first-child{font-size:22px}
  .management-shell .header-account{display:none}
}
