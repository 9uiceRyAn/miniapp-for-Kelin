<view class="workspace-shell"><include src="../../templates/workspace-sidebar.wxml"/><view class="workspace-main"><view class="workspace-header"><view class="header-start"><button class="drawer-button" bindtap="toggleDrawer" aria-label="打开侧栏">☰</button><text>{{conversation.agent_name||'教学助手'}}</text></view><text class="breadcrumb">对话</text></view><view class="workspace-content chat-content"><view class="nav"><text class="back" bindtap="back">‹ 返回</text><text>{{conversation.agent_name||'教学助手'}}</text><text class="badge">{{conversation.mode==='library'?'资料管理':conversation.mode==='builder'?'创建助手':conversation.mode==='test'?'教师试聊':'教学会话'}}</text></view><text class="sub" wx:if="{{conversation.mode==='student'}}">该教学助手的教师可以查看本会话和提交的作业。</text><text class="sub" wx:if="{{conversation.mode==='builder'}}">这里的附件仅用于本次创建对话；共享教学材料请从教师工作台添加到公共库。</text><text class="sub" wx:if="{{readOnly}}">正在查看学生记录。</text><view wx:if="{{conversation.mode==='library' && !messages.length}}" class="library-welcome"><text class="card-title">教学资料管家</text><text>告诉我需要查找或整理哪些资料。可以上传文件，或直接提交教学文字。</text><text class="sub">新增、更新和撤下资料会先列出操作，确认后执行。公共资料可供所有教学助手检索。</text></view><button wx:if="{{hasOlder}}" bindtap="older">读取更早消息</button><view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}"><text class="speaker">{{item.role==='user'?'提问':'教学助手'}}</text><rich-text wx:if="{{item.nodes}}" nodes="{{item.nodes}}"/><text wx:else user-select="{{true}}">{{item.data.text}}</text><view wx:if="{{item.data.question}}" class="cite" data-ref="{{item.data.question}}" bindtap="citation">已附带题目 · 查看当时修订</view><view wx:for="{{item.data.assets}}" wx:key="resourceId" class="cite" data-id="{{item.resourceId}}" data-revision="{{item.revisionId}}" bindtap="openAsset">查看提交的附件</view><view wx:for="{{item.data.citations}}" wx:key="id" class="cite" data-ref="{{item}}" bindtap="citation">资料来源：{{item.title}} {{item.position||''}} {{item.url?'· 复制链接':''}}</view><button wx:if="{{conversation.mode==='builder'&&item.role==='assistant'&&!readOnly}}" data-index="{{index}}" bindtap="applyDraft">查看后应用到教学草稿</button></view><view wx:if="{{running}}" class="message"><text>{{partial}}</text><text class="status">{{progress}}</text></view><text wx:if="{{!running}}" class="status">{{progress}}</text><text wx:if="{{error}}" class="error">{{error}}</text><view class="card" wx:if="{{assets.length}}"><text class="label">本会话附件</text><view wx:for="{{assets}}" wx:key="resourceId" class="row"><button data-index="{{index}}" bindtap="asset">{{item.selected?'☑':'□'}} {{item.data.title}} · {{item.status}}</button><text class="back" data-id="{{item.resourceId}}" data-revision="{{item.revisionId}}" bindtap="openAsset">查看</text></view></view><view wx:if="{{conversation.mode==='library'}}" class="library-actions"><view wx:for="{{libraryActions}}" wx:key="id" class="library-action"><text class="card-title">{{item.proposal.label}} · {{item.proposal.title}}</text><text wx:if="{{item.proposal.previousTitle}}" class="sub">原资料：{{item.proposal.previousTitle}}</text><text wx:if="{{item.proposal.text}}" class="library-action-text" user-select="{{true}}">{{item.proposal.text}}</text><text class="sub">{{item.status==='applied'?(item.outcome.status==='withdrawn'?'已撤下资料':'已提交，解析状态可在资料详情查看'):item.status==='applying'?'正在执行':item.status==='action_failed'?item.error:'等待确认 · 将更改公共教学资料'}}</text><button wx:if="{{item.status==='completed' && !readOnly}}" data-id="{{item.id}}" loading="{{confirmingAction===item.id}}" disabled="{{!!confirmingAction || running}}" bindtap="confirmLibraryAction">确认{{item.proposal.label}}</button><button wx:if="{{item.status==='applied' && item.outcome.revisionId}}" data-id="{{item.outcome.resourceId}}" data-revision="{{item.outcome.revisionId}}" bindtap="openAsset">查看资料与解析状态</button></view></view><view class="composer conversation-composer" wx:if="{{!readOnly}}"><view wx:if="{{question}}" class="cite">{{questionTitle}}<text class="back" bindtap="removeQuestion"> 移除</text></view><textarea value="{{text}}" maxlength="-1" bindinput="input" placeholder="{{conversation.mode==='library'?'例如：查找积分讲义，或将附件加入公共教学资料…':'输入问题、作文或学习目标…'}}" adjust-position="{{true}}" cursor-spacing="24"/><view class="actions"><button bindtap="attach" loading="{{uploading}}" disabled="{{running}}">图片 / PDF / DOCX</button><button wx:if="{{running}}" bindtap="cancel">停止生成</button><button wx:else class="primary" disabled="{{uploading}}" bindtap="send">发送</button></view></view></view></view><include src="../../templates/workspace-bottom.wxml"/></view>