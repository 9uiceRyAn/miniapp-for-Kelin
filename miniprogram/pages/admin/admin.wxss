@import "../../styles/workspace-tokens.wxss";
@import "../../styles/workspace-layout.wxss";
@import "../../styles/workspace-content.wxss";
@import "../../styles/workspace-components.wxss";

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 12px 0;
  border-bottom: 1px solid var(--ws-border);
  font-size: 12px;
}
.price-row-name {
  font-weight: 500;
  color: var(--ws-text);
}
.price-row-meta {
  color: var(--ws-secondary);
}
.storage-card {
  padding: 16px 18px;
  margin-bottom: 18px;
  background: var(--ws-sidebar);
  border: 1px solid var(--ws-border);
  border-radius: var(--ws-radius);
}
.storage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.storage-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--ws-text);
}
.storage-balance {
  margin-top: 8px;
  font-size: 13px;
  color: var(--ws-text);
  font-weight: 500;
}
.storage-bar {
  margin-top: 10px;
  height: 8px;
  width: 100%;
  border-radius: 999px;
  background: var(--ws-border);
  overflow: hidden;
}
.storage-bar-fill {
  height: 100%;
  background: var(--ws-accent);
  border-radius: 999px;
}
.storage-bar-fill.is-danger {
  background: var(--ws-danger);
}
.storage-meta {
  display: block;
  margin-top: 10px;
  font-size: 12px;
  color: var(--ws-secondary);
  line-height: 1.6;
}
