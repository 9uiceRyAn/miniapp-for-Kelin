<view class="device-nav workspace-shell" style="{{navigationStyle}}">
  <button wx:if="{{!drawerOpen}}" hover-class="motion-pressed" hover-stay-time="70" class="drawer-button" bindtap="toggleDrawer" aria-expanded="{{drawerOpen}}" aria-label="打开侧栏">☰</button>
  <include src="../../templates/workspace-sidebar.wxml"/>
  <view class="workspace-main">
    <view class="workspace-header">
      <view class="header-start"><text>平台与 API 管理</text></view>
    </view>
    <view class="workspace-content">
    <view wx:if="{{locked}}" class="ws-gate-wrap">
      <view class="ws-gate-card">
        <text class="ws-gate-title">管理员密码解锁</text>
        <text class="ws-gate-desc">输入共享管理员密码后可管理模型连接、密钥与计费价格，解锁后 15 分钟内通用。</text>
        <input
          class="ws-input"
          password="{{true}}"
          value="{{password}}"
          data-field="password"
          bindinput="input"
          bindconfirm="unlock"
          data-hint-id="managementPassword"
          bindfocus="onInputHintFocus"
          bindblur="onInputHintBlur"
          placeholder="{{inputHintFocus==='managementPassword'?'':'输入管理员密码'}}"
        />
        <button class="ws-btn ws-btn-primary ws-btn-block" bindtap="unlock" loading="{{busy}}" disabled="{{busy||!password}}">解锁平台管理</button>
        <view wx:if="{{error}}" class="ws-error-box">{{error}}</view>
      </view>
    </view>

    <block wx:else>
      <view class="ws-toolbar-secondary">
        <button class="ws-btn ws-btn-primary ws-btn-sm" bindtap="openCreateSheet">＋ 添加模型</button>
        <button class="ws-btn ws-btn-secondary ws-btn-sm" bindtap="openPriceSheet">价格配置</button>
        <button class="ws-btn ws-btn-secondary ws-btn-sm" bindtap="usage">平台费用</button>
      </view>
      <view wx:if="{{storage}}" class="storage-card">
        <view class="storage-head">
          <text class="storage-title">服务器储存空间</text>
          <button class="ws-btn ws-btn-secondary ws-btn-sm" bindtap="refreshStorage" loading="{{storageLoading}}" disabled="{{storageLoading}}">刷新</button>
        </view>
        <text class="storage-balance" style="display:block;">剩余 {{storage.freeLabel}} / 共 {{storage.totalLabel}}（已用 {{storage.usedPercent}}%）</text>
        <view class="storage-bar">
          <view class="storage-bar-fill {{storage.highUsage?'is-danger':''}}" style="width: {{storage.usedPercent}}%;"/>
        </view>
        <text class="storage-meta">网盘资料 {{storage.activeLabel}}（{{storage.activeCount}} 个） · 回收站 {{storage.trashLabel}}（{{storage.trashCount}} 个）</text>
        <view class="storage-meta">题库媒体文件 {{storage.questionBankLabel}}</view>
      </view>
      <text class="subpage-subtitle">所有新接入与存量模型默认支持文字、工具调用与视觉识别；更换上游模型请新增配置以保留历史会话版本。</text>

      <view wx:if="{{error && !sheetMode}}" class="ws-error-box">{{error}}</view>

      <view class="ws-list" wx:if="{{models.length}}">
        <view wx:for="{{models}}" wx:key="id" class="ws-list-row">
          <view class="ws-list-main">
            <view class="ws-list-title-row">
              <text class="ws-list-title">{{item.name}}</text>
              <text wx:if="{{settings.defaultChatModelId===item.id || settings.builderModelId===item.id}}" class="ws-badge ws-badge-success">默认模型</text>
              <text class="ws-badge {{item.enabled?'ws-badge-default':'ws-badge-danger'}}">{{item.enabled?'可用':'已停用'}}</text>
            </view>
            <text class="ws-list-meta">{{item.upstream_model}}</text>
            <view class="ws-badge-row">
              <text class="ws-badge {{item.capabilities.verified.text?'ws-badge-success':'ws-badge-draft'}}">文字 {{item.capabilities.verified.text?'✓':'待测'}}</text>
              <text class="ws-badge {{item.capabilities.verified.tools?'ws-badge-success':'ws-badge-draft'}}">工具 {{item.capabilities.verified.tools?'✓':'待测'}}</text>
              <text class="ws-badge {{item.capabilities.verified.vision?'ws-badge-success':'ws-badge-draft'}}">视觉 {{item.capabilities.verified.vision?'✓':'待测'}}</text>
            </view>
          </view>
          <view class="ws-list-actions">
            <button class="ws-btn ws-btn-secondary ws-btn-sm" data-id="{{item.id}}" bindtap="test" disabled="{{testingId===item.id}}" loading="{{testingId===item.id}}">测试连接</button>
            <button class="ws-btn ws-btn-secondary ws-btn-sm" data-index="{{index}}" bindtap="openModelMenu" aria-label="更多操作">⋯</button>
          </view>
        </view>
      </view>
      <view wx:else class="ws-empty">尚未配置模型，请点击上方「＋ 添加模型」</view>
    </block>
    </view>
  </view>
  <include src="../../templates/workspace-bottom.wxml"/>

  <!-- 添加模型抽屉（仅 4 项，默认全能力含视觉） -->
  <block wx:if="{{sheetMode==='create'}}">
    <view class="ws-overlay" bindtap="closeSheet"/>
    <view class="ws-sheet" role="dialog" aria-label="添加模型">
      <view class="ws-sheet-header">
        <view>
          <text class="ws-sheet-title">添加模型连接</text>
          <text class="ws-sheet-subtitle">默认启用文字、工具调用与视觉识别能力</text>
        </view>
        <button class="ws-sheet-close" bindtap="closeSheet" disabled="{{saving}}" aria-label="关闭">×</button>
      </view>
      <scroll-view scroll-y class="ws-sheet-body">
        <text class="ws-field-label">显示名称</text>
        <input class="ws-input" data-hint-id="hint0" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" data-field="name" value="{{name}}" bindinput="input" placeholder="{{inputHintFocus==='hint0'?'':'例如：学习问答模型'}}"/>
        <text class="ws-field-label">供应商 / 模型标识</text>
        <input class="ws-input" data-hint-id="hint1" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" data-field="upstreamModel" value="{{upstreamModel}}" bindinput="input" placeholder="{{inputHintFocus==='hint1'?'':'例如：openai/gpt-4o'}}"/>
        <text class="ws-field-label">API 地址（选填）</text>
        <input class="ws-input" data-hint-id="hint2" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" data-field="baseURL" value="{{baseURL}}" bindinput="input" placeholder="{{inputHintFocus==='hint2'?'':'留空使用供应商默认地址'}}"/>
        <text class="ws-field-label">供应商 API 密钥</text>
        <input class="ws-input" data-hint-id="hint3" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" data-field="apiKey" value="{{apiKey}}" bindinput="input" password="{{true}}" placeholder="{{inputHintFocus==='hint3'?'':'输入 API Key'}}"/>
        <view wx:if="{{error}}" class="ws-error-box">{{error}}</view>
        <view class="ws-sheet-spacer"/>
      </scroll-view>
      <view class="ws-sheet-footer">
        <button class="ws-btn ws-btn-secondary" bindtap="closeSheet" disabled="{{saving}}">取消</button>
        <button class="ws-btn ws-btn-primary" bindtap="create" loading="{{saving}}" disabled="{{saving||!name||!upstreamModel||!apiKey}}">保存模型</button>
      </view>
    </view>
  </block>

  <!-- 轮换密钥抽屉 -->
  <block wx:if="{{sheetMode==='rotate'}}">
    <view class="ws-overlay" bindtap="closeSheet"/>
    <view class="ws-sheet" role="dialog" aria-label="轮换密钥">
      <view class="ws-sheet-header">
        <view>
          <text class="ws-sheet-title">轮换密钥</text>
          <text class="ws-sheet-subtitle">更新「{{editName}}」的供应商密钥，保存后所有助手立即生效</text>
        </view>
        <button class="ws-sheet-close" bindtap="closeSheet" disabled="{{saving}}" aria-label="关闭">×</button>
      </view>
      <scroll-view scroll-y class="ws-sheet-body">
        <text class="ws-field-label">新的 API 密钥</text>
        <input class="ws-input" password="{{true}}" value="{{rotateKey}}" data-field="rotateKey" bindinput="input" data-hint-id="rotateKey" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" placeholder="{{inputHintFocus==='rotateKey'?'':'输入新的 API Key'}}"/>
        <view wx:if="{{error}}" class="ws-error-box">{{error}}</view>
        <view class="ws-sheet-spacer"/>
      </scroll-view>
      <view class="ws-sheet-footer">
        <button class="ws-btn ws-btn-secondary" bindtap="closeSheet" disabled="{{saving}}">取消</button>
        <button class="ws-btn ws-btn-primary" bindtap="rotate" loading="{{saving}}" disabled="{{saving||!rotateKey}}">保存新密钥</button>
      </view>
    </view>
  </block>

  <!-- 价格配置抽屉 -->
  <block wx:if="{{sheetMode==='price'}}">
    <view class="ws-overlay" bindtap="closeSheet"/>
    <view class="ws-sheet" role="dialog" aria-label="价格配置">
      <view class="ws-sheet-header">
        <view>
          <text class="ws-sheet-title">模型计费价格</text>
          <text class="ws-sheet-subtitle">模型按每百万 token 计价，历史记录保留当时的价格快照</text>
        </view>
        <button class="ws-sheet-close" bindtap="closeSheet" disabled="{{saving}}" aria-label="关闭">×</button>
      </view>
      <scroll-view scroll-y class="ws-sheet-body">
        <text class="ws-field-label">选择模型或服务</text>
        <picker range="{{priceModels}}" range-key="name" value="{{selected}}" bindchange="pick">
          <view class="ws-picker"><text>{{priceModels[selected].name||'请选择'}}</text><text>⌄</text></view>
        </picker>
        <text class="ws-field-label">币种</text>
        <input class="ws-input" data-hint-id="hint4" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" value="{{currency}}" data-field="currency" bindinput="input" placeholder="{{inputHintFocus==='hint4'?'':'三字母币种，例如 USD'}}"/>
        <block wx:if="{{priceModels[selected].id!=='tavily'}}">
          <text class="ws-field-label">输入单价 / 百万 token</text>
          <input class="ws-input" data-hint-id="hint5" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" value="{{inputPrice}}" data-field="inputPrice" bindinput="input" placeholder="{{inputHintFocus==='hint5'?'':'例如：2.50'}}"/>
          <text class="ws-field-label">输出单价 / 百万 token</text>
          <input class="ws-input" data-hint-id="hint6" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" value="{{outputPrice}}" data-field="outputPrice" bindinput="input" placeholder="{{inputHintFocus==='hint6'?'':'例如：10.00'}}"/>
          <text class="ws-field-label">缓存读取单价 / 百万 token（选填）</text>
          <input class="ws-input" data-hint-id="hint7" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" value="{{cachedPrice}}" data-field="cachedPrice" bindinput="input" placeholder="{{inputHintFocus==='hint7'?'':'可留空'}}"/>
        </block>
        <block wx:else>
          <text class="ws-field-label">每 credit 单价</text>
          <input class="ws-input" data-hint-id="hint8" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" value="{{creditPrice}}" data-field="creditPrice" bindinput="input" placeholder="{{inputHintFocus==='hint8'?'':'例如：0.01'}}"/>
        </block>
        <view wx:if="{{error}}" class="ws-error-box">{{error}}</view>

        <view class="ws-section-head">
          <text class="ws-section-title">历史价格版本</text>
          <text class="ws-section-meta">{{prices.length}} 条</text>
        </view>
        <view wx:for="{{prices}}" wx:key="id" class="price-row">
          <text class="price-row-name">{{item.modelName||item.model_id}}</text>
          <text class="price-row-meta">{{item.currency}} · {{item.effective_at}}</text>
        </view>
        <view class="ws-sheet-spacer"/>
      </scroll-view>
      <view class="ws-sheet-footer">
        <button class="ws-btn ws-btn-secondary" bindtap="closeSheet" disabled="{{saving}}">关闭</button>
        <button class="ws-btn ws-btn-primary" bindtap="price" loading="{{saving}}" disabled="{{saving}}">保存价格版本</button>
      </view>
    </view>
  </block>
</view>
