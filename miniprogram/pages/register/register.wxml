<view class="device-nav account-page" style="{{navigationStyle}}">
 <view class="safe-top"/>
 <view class="account-header"><view class="account-brand"><image class="account-logo" src="/images/collins-logo.png" mode="aspectFit"/><text>COLLINS</text></view><text class="account-back" bindtap="goBack">‹ 返回登录</text></view>
 <view class="account-body register-body">
  <text class="account-title">创建账号</text><text class="account-summary">选择你的身份，开始使用学习工作台。</text>
  <view class="account-roles"><view class="account-role {{role==='teacher'?'selected':''}}" data-role="teacher" bindtap="selectRole"><text class="account-role-title">教师</text><text class="account-role-desc">管理资料与教学助手</text></view><view class="account-role {{role==='student'?'selected':''}}" data-role="student" bindtap="selectRole"><text class="account-role-title">学生</text><text class="account-role-desc">练习题目与获取作业辅导</text></view></view>
  <view class="account-field-grid">
   <view class="account-group"><text class="account-label">用户名</text><view class="account-input-wrap"><input class="account-input" aria-label="用户名，3–30 位英文字母、数字或下划线" value="{{username}}" maxlength="30" data-field="username" bindinput="onInput"/></view><text class="account-field-hint">3–30 位英文字母、数字或下划线</text></view>
   <view class="account-group"><text class="account-label">显示名称</text><view class="account-input-wrap"><input data-hint-id="hint1" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" class="account-input" value="{{displayName}}" placeholder="{{inputHintFocus==='hint1'?'':'你的姓名或称呼'}}" maxlength="30" data-field="displayName" bindinput="onInput"/></view></view>
   <view class="account-group"><text class="account-label">密码</text><view class="account-input-wrap"><input class="account-input" aria-label="密码，6–72 位" value="{{password}}" password="{{true}}" maxlength="72" data-field="password" bindinput="onInput"/></view><text class="account-field-hint">6–72 位</text></view>
   <view class="account-group"><text class="account-label">确认密码</text><view class="account-input-wrap"><input data-hint-id="hint3" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" class="account-input" value="{{confirmPassword}}" password="{{true}}" placeholder="{{inputHintFocus==='hint3'?'':'再次输入密码'}}" maxlength="72" data-field="confirmPassword" bindinput="onInput"/></view></view>
  </view>
  <view class="account-group"><text class="account-label">{{role==='teacher'?'教师':'学生'}}注册码</text><view class="account-input-wrap"><input data-hint-id="hint4" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" class="account-input" value="{{registerCode}}" password="{{true}}" placeholder="{{inputHintFocus==='hint4'?'':'请输入内部注册码'}}" maxlength="64" data-field="registerCode" bindinput="onInput"/></view></view>
  <view wx:if="{{errorMessage}}" class="account-error">{{errorMessage}}</view>
  <button hover-class="motion-pressed" hover-stay-time="70" class="account-submit" loading="{{loading}}" disabled="{{loading}}" bindtap="submitRegister">{{loading?'正在创建':'创建账号'}}</button>
  <view class="account-switch"><text>已有账号？</text><text class="account-link" bindtap="goBack">返回登录</text></view>
 </view>
</view>
