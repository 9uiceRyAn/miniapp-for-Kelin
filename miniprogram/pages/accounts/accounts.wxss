@import "../../styles/workspace-tokens.wxss";

.accounts {
  max-width: 760px;
  margin: 0 auto;
  padding: 16px 20px 32px;
  color: var(--ws-text);
  font: 15px/1.5 var(--ws-font);
}
.accounts .card { margin-bottom: 16px; padding: 20px; border: 1px solid var(--ws-border); border-radius: 14px; }
.accounts .heading { display: block; font-size: 20px; font-weight: 650; }
.accounts .section-line, .accounts .pager { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.accounts .field-label { display: block; margin: 14px 0 6px; font-size: 14px; font-weight: 600; }
.accounts .section-line .field-label { margin: 0; }
.accounts .meta, .accounts .sub, .accounts .username, .accounts .pager text { display: block; color: #55565b; font-size: 13px; }
.accounts .sub { margin-top: 4px; }
.accounts .identity { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.accounts .user-title { display: block; font-size: 17px; font-weight: 600; }
.accounts .username { margin: 2px 0; }
.accounts .code-card, .accounts .editor { margin-top: 12px; padding: 14px; background: var(--ws-sidebar); border-radius: 10px; }
.accounts .code { display: block; margin: 6px 0; font: 15px/1.5 monospace; overflow-wrap: anywhere; }
.accounts .field-action, .accounts .filters { display: flex; align-items: stretch; gap: 8px; }
.accounts .filters { margin: 10px 0 16px; }
.accounts .field-action input, .accounts .filters picker { flex: 1; min-width: 0; }
.accounts input, .accounts button, .accounts .picker-face {
  box-sizing: border-box; min-width: 44px; min-height: 44px; padding: 8px 12px;
  color: var(--ws-text); background: #fff; border: 1px solid #81838a;
  border-radius: 8px; font: 14px/1.45 var(--ws-font);
}
.accounts input {
  height: 44px;
  padding: 0 12px;
  font-size: 16px;
  line-height: normal;
  text-align: center;
}
.accounts input:focus, .accounts .field-action:focus-within input { border-color: #242424; box-shadow: inset 0 0 0 1px #242424; }
.accounts button { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: auto; margin: 0; }
.accounts button::after { border: 0; }
.accounts .primary { background: #242424; color: #fff; border-color: #242424; }
.accounts .picker-face { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
.accounts .chevron { width: 7px; height: 7px; flex-shrink: 0; border: solid #51535a; border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); }
.accounts .user { padding: 14px 0; border-top: 1px solid var(--ws-border); }
.accounts .user:last-child { padding-bottom: 0; }
.accounts .editor .field-label:first-child { margin-top: 0; }
.accounts .status-action { margin-top: 16px; }
.accounts .danger { color: #8c273b; border-color: #a85768; }
.accounts button[disabled] { color: #686970; background: #efeff1; border-color: #d5d5d9; }
.accounts .empty, .accounts .error { display: block; margin-top: 12px; }
.accounts .error { color: var(--ws-danger); }
.accounts .pager { margin-top: 12px; }
@media (max-width: 480px) {
  .accounts { padding: 12px 12px 24px; }
  .accounts .card { padding: 14px; }
}
@media (max-width: 340px) {
  .accounts .filters { flex-direction: column; }
  .accounts .editor .field-action { flex-direction: column; }
  .accounts .editor input { flex: none; width: 100%; }
}
