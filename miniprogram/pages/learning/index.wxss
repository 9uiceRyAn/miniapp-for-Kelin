@import "../../styles/learning.wxss";
@import "../../styles/workspace-layout.wxss";
@import "../../styles/workspace-content.wxss";
@import "../../styles/workspace-components.wxss";
@import "../../styles/usage.wxss";

.drive-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:10px 0 14px}
.drive-toolbar-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.drive-breadcrumbs{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:12px;color:var(--ws-secondary);margin-bottom:12px}
.drive-back-btn{margin-right:4px}
.drive-crumb{color:var(--ws-text);font-weight:500;padding:4px 2px}
.drive-crumb-sep{color:var(--ws-tertiary)}
.drive-mark-toggle{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ws-secondary)}
.drive-mark-toggle switch{transform:scale(.7);transform-origin:right center}
.drive-tree-item{display:flex;align-items:center;justify-content:space-between;padding:12px 10px;border-bottom:1px solid var(--ws-border);font-size:13px}
.drive-tree-item.is-selected{background:var(--ws-sidebar);font-weight:600}
.drive-text-preview{display:block;font-size:13px;line-height:1.65;color:var(--ws-text);white-space:pre-wrap;word-break:break-word;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.drive-md-preview{font-size:14px;line-height:1.65;color:var(--ws-text)}
.drive-md-preview mp-html,.drive-md-preview rich-text{display:block;white-space:normal}

/* Profile: compact account identity, teaching shortcuts and a separate management group. */
.workspace-content.profile-content{max-width:940px;padding-top:20px;padding-bottom:30px}.profile-identity{display:flex;align-items:center;gap:17px;padding:4px 0 26px;border-bottom:1px solid var(--ws-border)}.profile-user{min-width:0;flex:1}.profile-name{display:block;font-size:27px;line-height:1.35;font-weight:600;letter-spacing:-.5px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.profile-roles{display:flex;align-items:center;gap:7px;margin-top:9px;flex-wrap:wrap}.profile-role{display:block;font-size:10px;line-height:1.5;padding:3px 8px;border-radius:6px;color:var(--ws-secondary);background:var(--ws-sidebar)}.profile-hub-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin-top:26px;align-items:start}.profile-section{min-width:0}.profile-section-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;font-size:12px;font-weight:500;color:var(--ws-text)}.profile-section-heading>text:last-child{font-size:10px;font-weight:400;color:var(--ws-tertiary)}.profile-link-group{border:1px solid var(--ws-border);border-radius:15px;overflow:hidden;background:var(--ws-canvas)}.workspace-shell .profile-link{display:flex;align-items:center;gap:12px;width:100%;min-width:0;min-height:76px;border-radius:0;padding:15px 16px;background:transparent;text-align:left}.workspace-shell .profile-link+.profile-link{border-top:1px solid var(--ws-border)}.profile-link-icon{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:35px;height:35px;border-radius:10px;background:var(--ws-sidebar);color:#555}.profile-link-copy{min-width:0;flex:1}.profile-link-title{display:block;font-size:13px;line-height:1.5;font-weight:500}.profile-link-description{display:block;font-size:10px;line-height:1.6;margin-top:4px;color:var(--ws-secondary)}.profile-link-arrow{font-size:22px;font-weight:300;color:var(--ws-tertiary);flex-shrink:0;line-height:1}.workspace-shell .profile-logout-control{display:flex;align-items:center;justify-content:center;gap:10px;min-height:44px;width:160px;margin:25px 0 0 auto;padding:11px 16px;border:1px solid var(--ws-border);border-radius:12px;color:var(--ws-secondary);font-size:12px;background:var(--ws-canvas)}
@media(max-width:700px){.workspace-content.profile-content{padding-top:12px;padding-bottom:24px}.profile-identity{gap:14px;padding:2px 0 21px}.profile-name{font-size:25px}.profile-roles{margin-top:8px;gap:6px}.profile-hub-grid{grid-template-columns:minmax(0,1fr);gap:23px;margin-top:22px}.profile-section-heading{font-size:12px;margin-bottom:11px}.workspace-shell .profile-link{min-height:70px;padding:13px 14px;gap:12px}.profile-link-icon{width:33px;height:33px}.profile-link-title{font-size:13px}.profile-link-description{font-size:10px}.workspace-shell .profile-logout-control{width:100%;margin-top:19px;min-height:43px;background:var(--ws-sidebar);border-color:transparent}}
