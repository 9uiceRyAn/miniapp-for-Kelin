@import "../../styles/learning.wxss";
@import "../../styles/workspace-tokens.wxss";
@import "../../styles/workspace-layout.wxss";
@import "../../styles/workspace-content.wxss";
@import "../../styles/workspace-motion.wxss";
@import "../../styles/workspace-components.wxss";
@import "../../styles/usage.wxss";

.drive-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:10px 0 14px}
.drive-toolbar-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.drive-breadcrumbs{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:12px;color:var(--ws-secondary);margin-bottom:12px}
.drive-crumb{color:var(--ws-text);font-weight:500;padding:4px 2px}
.drive-crumb-sep{color:var(--ws-tertiary)}
.drive-mark-toggle{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ws-secondary)}
.drive-mark-toggle switch{transform:scale(.7);transform-origin:right center}
.drive-mark-box{width:22px;height:22px;border:1px solid var(--ws-border);border-radius:6px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;color:var(--ws-on-accent);background:var(--ws-canvas);flex-shrink:0}
.drive-mark-box.is-marked{background:var(--ws-accent);border-color:var(--ws-accent)}
.drive-tree-item{display:flex;align-items:center;justify-content:space-between;padding:12px 10px;border-bottom:1px solid var(--ws-border);font-size:13px}
.drive-tree-item.is-selected{background:var(--ws-sidebar);font-weight:600}

/* Profile: compact account identity, teaching shortcuts and a separate management group. */
.workspace-content.profile-content{max-width:940px;padding-top:20px;padding-bottom:30px}.profile-identity{display:flex;align-items:center;gap:17px;padding:4px 0 26px;border-bottom:1px solid var(--ws-border)}.workspace-shell .profile-avatar{width:66px;height:66px;flex-shrink:0;display:flex;align-items:center;justify-content:center;padding:0;margin:0;border:0;border-radius:21px;background:var(--ws-accent);color:var(--ws-on-accent);font-size:29px;font-weight:500;letter-spacing:0;overflow:hidden}.workspace-shell .profile-avatar::after{border:0}.profile-avatar-img{width:100%;height:100%;display:block}.profile-user{min-width:0;flex:1}.profile-name{display:block;font-size:27px;line-height:1.35;font-weight:600;letter-spacing:-.5px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.profile-roles{display:flex;align-items:center;gap:7px;margin-top:9px;flex-wrap:wrap}.profile-role,.profile-admin-role{display:block;font-size:10px;line-height:1.5;padding:3px 8px;border-radius:6px;color:var(--ws-secondary);background:var(--ws-sidebar)}.profile-admin-role{border:1px solid var(--ws-border);padding:2px 7px;background:var(--ws-canvas)}.profile-hub-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin-top:26px;align-items:start}.profile-section{min-width:0}.profile-section-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;font-size:12px;font-weight:500;color:var(--ws-text)}.profile-section-heading>text:last-child{font-size:10px;font-weight:400;color:var(--ws-tertiary)}.profile-feature-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}.workspace-shell .profile-feature{display:flex;align-items:center;gap:14px;position:relative;width:100%;min-width:0;min-height:104px;padding:19px 38px 19px 18px;text-align:left;border:1px solid var(--ws-border);border-radius:15px;background:var(--ws-sidebar);color:var(--ws-text)}.workspace-shell .profile-feature-primary{background:var(--ws-accent);border-color:var(--ws-accent);color:var(--ws-on-accent)}.profile-feature-icon{display:flex;align-items:center;justify-content:center;width:38px;height:38px;flex-shrink:0;border-radius:11px;border:1px solid var(--ws-border);background:var(--ws-canvas)}.profile-feature-primary .profile-feature-icon{background:#ffffff0f;border-color:#ffffff26}.profile-feature-copy{min-width:0}.profile-feature-title{display:block;font-size:14px;font-weight:500;line-height:1.5;overflow-wrap:anywhere}.profile-feature-description{display:block;font-size:10px;line-height:1.7;color:var(--ws-secondary);margin-top:5px}.profile-feature-primary .profile-feature-description{color:#ffffffab}.profile-feature-arrow{position:absolute;right:16px;top:19px;font-size:16px;line-height:1;color:var(--ws-tertiary)}.profile-feature-primary .profile-feature-arrow{color:#ffffffa6}.profile-link-group{border:1px solid var(--ws-border);border-radius:15px;overflow:hidden;background:var(--ws-canvas)}.workspace-shell .profile-link{display:flex;align-items:center;gap:12px;width:100%;min-width:0;min-height:76px;border-radius:0;padding:15px 16px;background:transparent;text-align:left}.workspace-shell .profile-link+.profile-link{border-top:1px solid var(--ws-border)}.profile-link-icon{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:35px;height:35px;border-radius:10px;background:var(--ws-sidebar);color:#555}.profile-link-copy{min-width:0;flex:1}.profile-link-title{display:block;font-size:13px;line-height:1.5;font-weight:500}.profile-link-description{display:block;font-size:10px;line-height:1.6;margin-top:4px;color:var(--ws-secondary)}.profile-link-arrow{font-size:22px;font-weight:300;color:var(--ws-tertiary);flex-shrink:0;line-height:1}.workspace-shell .profile-logout-control{display:flex;align-items:center;justify-content:center;gap:10px;min-height:44px;width:160px;margin:25px 0 0 auto;padding:11px 16px;border:1px solid var(--ws-border);border-radius:12px;color:var(--ws-secondary);font-size:12px;background:var(--ws-canvas)}.profile-exit-glyph{position:relative;width:17px;height:18px;border-left:1.4px solid currentColor}.profile-exit-glyph::before{position:absolute;content:"";top:0;left:0;width:8px;height:16px;border-top:1.4px solid currentColor;border-bottom:1.4px solid currentColor}.profile-exit-glyph::after{position:absolute;content:"→";left:4px;top:-2px;font-size:19px;line-height:18px}.profile-glyph{position:relative;width:22px;height:22px;flex-shrink:0;color:inherit}.profile-icon-stack::before,.profile-icon-stack::after{position:absolute;content:"";width:12px;height:14px;border:1.4px solid currentColor;border-radius:2px}.profile-icon-stack::before{left:2px;top:5px;opacity:.55}.profile-icon-stack::after{left:6px;top:1px}.profile-icon-agent::before{position:absolute;content:"";left:1px;top:2px;width:18px;height:13px;border:1.4px solid currentColor;border-radius:5px}.profile-icon-agent::after{position:absolute;content:"";left:5px;top:15px;width:5px;height:4px;border-left:1.4px solid currentColor;transform:skewY(-32deg)}.profile-icon-usage::before{position:absolute;content:"";left:1px;bottom:2px;width:19px;height:16px;border-left:1.4px solid currentColor;border-bottom:1.4px solid currentColor}.profile-icon-usage::after{position:absolute;content:"";left:5px;bottom:5px;width:3px;height:6px;border-radius:1px;background:currentColor;box-shadow:6px -3px 0 currentColor,12px -7px 0 currentColor}.profile-icon-bank::before{position:absolute;content:"";left:3px;top:1px;width:15px;height:19px;border:1.4px solid currentColor;border-radius:2px}.profile-icon-bank::after{position:absolute;content:"";left:7px;top:6px;width:7px;height:1.4px;background:currentColor;box-shadow:0 4px 0 currentColor,0 8px 0 currentColor}.profile-icon-platform{display:grid;grid-template-columns:7px 7px;grid-template-rows:7px 7px;gap:4px;align-content:center;justify-content:center}.profile-icon-platform>view{border:1.4px solid currentColor;border-radius:2px}
@media(max-width:700px){.workspace-content.profile-content{padding-top:12px;padding-bottom:24px}.profile-identity{gap:14px;padding:2px 0 21px}.workspace-shell .profile-avatar{width:59px;height:59px;border-radius:19px;font-size:26px}.profile-name{font-size:25px}.profile-roles{margin-top:8px;gap:6px}.profile-hub-grid{grid-template-columns:minmax(0,1fr);gap:23px;margin-top:22px}.profile-section-heading{font-size:12px;margin-bottom:11px}.profile-feature-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.profile-feature-grid.profile-feature-single{grid-template-columns:minmax(0,1fr)}.workspace-shell .profile-feature{display:block;min-height:135px;padding:15px 14px;border-radius:14px}.profile-feature-icon{width:33px;height:33px;border-radius:10px;margin-bottom:14px}.profile-feature-arrow{top:17px;right:14px;font-size:15px}.profile-feature-title{font-size:13px}.profile-feature-description{font-size:10px;margin-top:5px}.workspace-shell .profile-link{min-height:70px;padding:13px 14px;gap:12px}.profile-link-icon{width:33px;height:33px}.profile-link-title{font-size:13px}.profile-link-description{font-size:10px}.workspace-shell .profile-logout-control{width:100%;margin-top:19px;min-height:43px;background:var(--ws-sidebar);border-color:transparent}.profile-feature-single .profile-feature{display:flex;align-items:center;gap:14px;min-height:92px;padding:17px 38px 17px 17px}.profile-feature-single .profile-feature-icon{margin:0}}
