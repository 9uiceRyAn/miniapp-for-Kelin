<view class="workspace-shell">
 <include src="../../templates/workspace-sidebar.wxml"/>
 <view class="workspace-main"><view class="workspace-header"><view class="header-start"><button class="drawer-button" bindtap="toggleDrawer" aria-label="打开侧栏">☰</button><text>{{sectionTitle}}</text><text wx:if="{{section==='bank'}}" class="breadcrumb">/ {{subjectLabel}}</text></view><text class="header-account" data-id="profile" bindtap="selectMain">{{user.display_name||user.name||'个人'}}</text></view>
 <view class="workspace-content {{section==='agents'?'chat-landing':''}}">
  <block wx:if="{{section==='bank'}}"><view class="heading-row"><text class="workspace-title">{{subjectLabel}}</text><button class="subtle-button" bindtap="toggleFilters">筛选 {{filtersOpen?'−':'＋'}}</button></view>
   <view class="workspace-search"><input value="{{q}}" placeholder="搜索题目、知识点或试卷编号" data-field="q" bindinput="input" bindconfirm="search"/><button bindtap="search" aria-label="搜索题目">搜索</button></view>
   <view class="advanced-filters" wx:if="{{filtersOpen}}"><picker range="{{collections}}" range-key="label" value="{{collectionIndex}}" data-field="collection" bindchange="filter"><view class="picker">{{collections[collectionIndex].label}}</view></picker><picker range="{{skills}}" range-key="label" value="{{skillIndex}}" data-field="skill" bindchange="filter"><view class="picker">{{skills[skillIndex].label}}</view></picker><view class="row"><text>仅显示待审核</text><switch checked="{{reviewRequired==='true'}}" bindchange="review" color="#242424"/></view><button bindtap="clear">重置筛选</button></view>
   <text class="workspace-label">知识点</text><view class="knowledge-tags"><button wx:for="{{tags}}" wx:key="key" class="knowledge-tag {{tagIndex===index?'selected':''}}" data-index="{{index}}" bindtap="selectTag">{{item.displayLabel||item.label}}</button></view>
   <view class="results-summary"><text>共 {{total}} 道题目</text><text wx:if="{{tag}}">{{tags[tagIndex].label}}</text></view>
   <view class="question-group" wx:for="{{questionGroups}}" wx:key="key" wx:for-item="group"><view class="group-heading"><text>{{group.label}}</text><text class="group-count">已载入 {{group.items.length}} 题</text></view><view class="question-row" wx:for="{{group.items}}" wx:key="id" data-id="{{item.resourceId}}" data-revision="{{item.revisionId}}" bindtap="openItem"><image wx:if="{{item.thumbnailUrl}}" class="question-thumb" src="{{item.thumbnailUrl}}" mode="aspectFit"/><view class="question-copy"><text class="question-title">{{item.title}}</text><text class="question-meta">{{item.collection_label}} · {{item.skill_label}}</text><text class="question-meta" wx:if="{{item.review_required||item.release_status==='provisional'}}">{{item.review_required?'待审核':''}} {{item.release_status==='provisional'?'暂定发布':''}}</text></view><text class="question-arrow">→</text></view></view>
  </block>
  <block wx:elif="{{section==='agents'}}"><view class="chat-welcome"><text class="workspace-title">今天想弄懂什么？</text></view><view class="landing-composer"><textarea value="{{landingText}}" data-field="landingText" bindinput="input" maxlength="-1" placeholder="提出问题，或从题库带入一道题…"/><view class="composer-tools"><picker wx:if="{{items.length}}" range="{{items}}" range-key="name" value="{{agentIndex}}" bindchange="chooseAgent"><view class="agent-choice">{{items[agentIndex].name}} ⌄</view></picker><text wx:else class="workspace-subtitle">暂无可用教学助手</text><button class="send-button" disabled="{{!items.length||startingChat}}" loading="{{startingChat}}" bindtap="startChat" aria-label="开始聊天">↑</button></view></view><view class="chat-suggestions"><button data-id="bank" bindtap="selectMain">从题库选一道题</button></view><button wx:if="{{items.length &lt; total}}" class="agent-more" bindtap="more" loading="{{loading}}">加载更多教学助手</button></block>
  <block wx:elif="{{section==='profile'}}"><text class="workspace-eyebrow">YOUR WORKSPACE</text><text class="workspace-title">{{user.display_name||user.name||'我的学习空间'}}</text><text class="workspace-subtitle">管理教学资料、教学助手与使用情况</text><text class="profile-label">学习与教学</text><button class="profile-row" data-id="library" bindtap="selectSection"><text>{{teacher?'教学资料管家':'公共教学资料'}}</text><text>{{teacher?'通过对话管理 →':'浏览与检索 →'}}</text></button><button wx:if="{{teacher}}" class="profile-row" data-id="teacher" bindtap="selectSection"><text>我的教学助手</text><text>创建与管理 →</text></button><text class="profile-label">账户</text><button class="profile-row" data-id="usage" bindtap="selectSection"><text>用量与费用</text><text>查看使用情况 →</text></button><button wx:if="{{admin}}" class="profile-row" bindtap="openAdmin"><text>平台管理</text><text>模型与权限 →</text></button><button class="profile-row" bindtap="home"><text>资料首页</text><text>A–E 资料与账户 →</text></button></block>
  <block wx:else><text class="workspace-title">{{sectionTitle}}</text></block>
  <view wx:if="{{section==='library'}}" class="workspace-search"><input value="{{q}}" placeholder="搜索资料正文" data-field="q" bindinput="input" bindconfirm="search"/><button bindtap="search">搜索</button></view>
  <block wx:if="{{section!=='agents' && section!=='profile'}}"> <view wx:if="{{section==='library'&&teacher}}" class="card"><text class="card-title">添加公共教学资料</text><text class="sub">提交并解析成功后，所有教学助手均可检索。学生作业请在会话中上传。</text><view class="actions"><button bindtap="uploadPublic" loading="{{uploading}}">上传 PDF、DOCX 或图片</button><button bindtap="existing">索引已有 A–E 资料</button></view><input placeholder="文字资料标题" data-field="publicTitle" bindinput="input" value="{{publicTitle}}"/><textarea placeholder="也可以直接输入教学文字资料" data-field="publicText" bindinput="input" value="{{publicText}}"/><button bindtap="addText">提交文字资料</button><view wx:if="{{chooseExisting}}"><picker range="{{['A','B','C','D','E']}}" bindchange="category"><view class="picker">{{category}} 类资料</view></picker><view wx:for="{{existingFiles}}" wx:key="id" class="row"><text class="grow">{{item.original_name}}</text><button data-id="{{item.id}}" bindtap="indexFile">加入教学检索</button></view></view></view>
 <view wx:if="{{section==='teacher'}}" class="actions"><button class="primary" bindtap="create">＋ 创建教学助手</button></view>
 <view wx:if="{{section==='usage'}}"><view class="tabs"><button data-id="self" bindtap="scope">我的使用</button><button wx:if="{{teacher}}" data-id="teacher" bindtap="scope">我的助手</button><button wx:if="{{admin}}" data-id="admin" bindtap="scope">全平台</button></view><view class="filters"><picker mode="date" data-field="from" bindchange="date"><view class="picker">{{from||'开始日期'}}</view></picker><picker mode="date" data-field="to" bindchange="date"><view class="picker">{{to||'结束日期'}}</view></picker><input wx:if="{{scope!=='self'}}" data-field="userId" value="{{userId}}" bindinput="input" placeholder="按学生账号 ID 筛选"/><button bindtap="search">应用条件</button></view><view wx:for="{{summary}}" wx:key="index" class="card"><text>{{item.currency||'未定价'}} · {{item.status}}：{{item.amount||'待核实'}} · {{item.calls}} 次计费操作</text></view></view>
 <view class="grid" wx:if="{{section!=='bank' && section!=='agents' && section!=='profile'}}"><view class="card" wx:for="{{items}}" wx:key="id">
  <view wx:if="{{section==='bank'||section==='library'}}" class="row" data-id="{{item.resourceId}}" data-revision="{{item.revisionId}}" bindtap="openItem"><image wx:if="{{item.thumbnailUrl}}" class="thumb" src="{{item.thumbnailUrl}}" mode="aspectFit"/><view class="grow"><text class="card-title">{{item.title}}</text><text class="sub">{{item.subject_label}} · {{item.collection_label}}</text><view><text class="badge">{{item.primary_tag_name||item.status||'资料'}}</text><text wx:if="{{item.review_required}}" class="badge">待审核</text><text wx:if="{{item.release_status==='provisional'}}" class="badge">暂定发布</text></view><text class="sub">{{item.subtitle}}</text><view wx:for="{{item.chunks}}" wx:key="position"><text class="sub">{{item.label}}：{{item.body}}</text></view></view></view>
  <view wx:elif="{{section==='agents'||section==='teacher'}}"><text class="card-title">{{item.name}}</text><text class="sub">{{item.description}}</text><text class="sub">教师：{{item.teacherName}}</text><view class="actions"><button wx:if="{{section==='agents'}}" class="primary" data-id="{{item.id}}" bindtap="startAgent">开始对话</button><button wx:else data-id="{{item.id}}" bindtap="edit">管理 · {{item.status}}</button></view></view>
  <view wx:elif="{{section==='history'}}" data-id="{{item.id}}" bindtap="conversation"><text class="card-title">{{item.name}}</text><text class="sub">{{item.mode}} · {{item.updated_at}}</text><text wx:if="{{agentId}}" class="sub">学生：{{item.ownerName||item.owner_id}}</text><text wx:if="{{item.active_run}}" class="badge">正在生成</text></view>
  <view wx:else><text class="card-title">{{item.currency||'未定价'}} {{item.amount||'待核实'}}</text><text class="sub">{{item.purpose}} · {{item.status}} · {{item.created_at}}</text><text class="sub">使用人 {{item.userName}} · {{item.modelName||item.model_id}}</text></view>
 </view></view>
 <view wx:if="{{loading}}" class="empty">正在读取…</view><view wx:elif="{{items.length===0}}" class="empty">暂无匹配内容</view><button wx:if="{{items.length<total}}" loading="{{loading}}" bindtap="more">加载更多</button>
</block>
 </view></view><include src="../../templates/workspace-bottom.wxml"/>
</view>