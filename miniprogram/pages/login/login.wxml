<view class="account-page login-page" style="{{pageInsets}}">
  <view class="safe-top"/>
  <view class="account-header">
    <view class="account-brand"><image class="account-logo" src="/images/collins-logo.png" mode="aspectFit"/><text>COLLINS</text></view>
    <text class="account-caption">学习工作台</text>
  </view>
  <view class="account-body">
    <text class="account-title">AI助手</text>
    <block wx:if="{{!wechatTicket}}">
      <view wx:if="{{autoLoggingIn}}" class="account-notice">正在使用已记住的设备自动登录…</view>
      <view class="account-group">
        <text class="account-label">用户名</text>
        <view class="account-input-wrap {{focusedField==='username'?'focused':''}}">
          <input data-hint-id="hint0" class="account-input" value="{{username}}" placeholder="{{inputHintFocus==='hint0'?'':'请输入用户名'}}" maxlength="30" bindinput="onUsernameInput" bindfocus="onUsernameFocus" bindblur="onInputBlur" confirm-type="next"/>
        </view>
      </view>
      <view class="account-group">
        <text class="account-label">密码</text>
        <view class="account-input-wrap {{focusedField==='password'?'focused':''}}">
          <input data-hint-id="hint1" class="account-input" value="{{password}}" password="{{!showPassword}}" placeholder="{{inputHintFocus==='hint1'?'':'请输入密码'}}" maxlength="72" bindinput="onPasswordInput" bindfocus="onPasswordFocus" bindblur="onInputBlur" confirm-type="done" bindconfirm="submitLogin"/>
          <text class="account-password-toggle" bindtap="togglePassword">{{showPassword?'隐藏':'显示'}}</text>
        </view>
      </view>
      <checkbox-group class="account-options" bindchange="changeRememberOptions">
        <label class="account-check"><checkbox value="username" checked="{{rememberUsername}}" color="#242424"/><text>记住用户名</text></label>
        <label class="account-check"><checkbox value="device" checked="{{rememberDevice}}" color="#242424"/><text>记住这台设备</text></label>
      </checkbox-group>
      <view wx:if="{{errorMessage}}" class="account-error">{{errorMessage}}</view>
      <button hover-class="motion-pressed" hover-stay-time="70" class="account-submit" bindtap="submitLogin" loading="{{loading}}" disabled="{{loading||autoLoggingIn}}">{{autoLoggingIn?'正在自动登录':loading?'正在验证':'登录'}}</button>
      <view class="account-wechat">
        <button class="account-wechat-button" type="primary" plain="{{true}}" bindtap="wechatLogin" loading="{{loading && wechatEnabled}}" disabled="{{!wechatEnabled||loading||autoLoggingIn}}">微信快捷登录</button>
        <text wx:if="{{wechatStatus}}" class="account-wechat-status">{{wechatStatus}}</text>
      </view>
      <view class="account-switch"><text>没有账号？</text><text class="account-link" bindtap="goRegister">创建账号</text></view>
    </block>
    <view wx:else class="account-wechat-panel">
      <view class="account-wechat-modes">
        <button class="account-wechat-mode {{wechatAction==='bind'?'selected':''}}" aria-pressed="{{wechatAction==='bind'}}" data-mode="bind" bindtap="wechatMode" disabled="{{loading}}">绑定已有账号</button>
        <button class="account-wechat-mode {{wechatAction==='register'?'selected':''}}" aria-pressed="{{wechatAction==='register'}}" data-mode="register" bindtap="wechatMode" disabled="{{loading}}">凭码注册</button>
      </view>
      <block wx:if="{{wechatAction==='bind'}}">
        <view class="account-group">
          <text class="account-label">原账号用户名</text>
          <view class="account-input-wrap {{inputHintFocus==='wxhint0'?'focused':''}}">
            <input class="account-input" data-hint-id="wxhint0" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" placeholder="{{inputHintFocus==='wxhint0'?'':'请输入原账号用户名'}}" value="{{username}}" data-field="username" bindinput="wechatField" maxlength="30" confirm-type="next"/>
          </view>
        </view>
        <view class="account-group">
          <text class="account-label">原账号密码</text>
          <view class="account-input-wrap {{inputHintFocus==='wxhint1'?'focused':''}}">
            <input class="account-input" data-hint-id="wxhint1" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" placeholder="{{inputHintFocus==='wxhint1'?'':'请输入原账号密码'}}" password value="{{password}}" data-field="password" bindinput="wechatField" maxlength="72" confirm-type="done" bindconfirm="wechatComplete"/>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="account-wechat-role">
          <text>注册为教师</text>
          <switch checked="{{wechatRole==='teacher'}}" bindchange="wechatRole" disabled="{{loading}}" aria-label="注册为教师"/>
        </view>
        <view class="account-group">
          <text class="account-label">注册码</text>
          <view class="account-input-wrap {{inputHintFocus==='wxhint2'?'focused':''}}">
            <input class="account-input" data-hint-id="wxhint2" bindfocus="onInputHintFocus" bindblur="onInputHintBlur" placeholder="{{inputHintFocus==='wxhint2'?'':'请输入内部注册码'}}" value="{{wechatRegisterCode}}" data-field="wechatRegisterCode" bindinput="wechatField" confirm-type="done" bindconfirm="wechatComplete"/>
          </view>
        </view>
      </block>
      <view wx:if="{{errorMessage}}" class="account-error">{{errorMessage}}</view>
      <button class="account-submit" bindtap="wechatComplete" loading="{{loading}}" disabled="{{loading||autoLoggingIn}}">确认</button>
      <button class="account-wechat-back" bindtap="closeWechatPanel" disabled="{{loading}}">返回账号登录</button>
    </view>
  </view>
</view>
