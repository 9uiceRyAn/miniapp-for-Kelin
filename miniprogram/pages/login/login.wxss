@import "../../styles/account.wxss";
@import "../../styles/workspace-motion.wxss";

.account-wechat {
  margin-top: 12px;
}

.account-wechat-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 46px;
  padding: 0 18px;
  font-size: 14px;
  font-weight: 500;
  line-height: 1.5;
}

.account-wechat-status {
  display: block;
  margin-top: 6px;
  color: var(--ws-secondary);
  font-size: 12px;
  text-align: center;
}

.account-wechat-panel {
  margin-top: 18px;
  padding: 18px;
  border: 1px solid var(--ws-border);
  border-radius: var(--ws-radius);
  background: var(--ws-sidebar);
}

.account-wechat-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 16px;
}

.account-wechat-tab {
  margin: 0;
  padding: 9px 12px;
  min-height: 40px;
  border-radius: var(--ws-radius);
  border: 1px solid var(--ws-border);
  background: var(--ws-canvas);
  color: var(--ws-secondary);
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
}

.account-wechat-tab::after {
  border: 0;
}

.account-wechat-tab.active {
  border-color: var(--ws-accent);
  background: var(--ws-accent);
  color: var(--ws-on-accent);
}

.account-wechat-panel .account-roles {
  margin: 4px 0 18px;
}

.account-wechat-avatar-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 4px;
}

.account-wechat-avatar-btn {
  width: 56px;
  height: 56px;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  border: 1px dashed var(--ws-border);
  background: var(--ws-canvas);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.account-wechat-avatar-btn::after {
  border: 0;
}

.account-wechat-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.account-wechat-avatar-placeholder {
  font-size: 22px;
  color: var(--ws-secondary);
  line-height: 1;
}

.account-wechat-avatar-copy {
  min-width: 0;
  flex: 1;
}

.account-wechat-avatar-title {
  display: block;
  font-size: 13px;
  color: var(--ws-text);
  font-weight: 500;
}

.account-wechat-avatar-hint {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--ws-secondary);
}
