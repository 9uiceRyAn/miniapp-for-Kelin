.login-page {
  min-height: 100vh;
  background: #f7f6f2;
  color: #20251f;
}

.desktop-only-inline {
  display: none;
}

.login-topbar {
  min-height: 98rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid #e4e1da;
  background: rgba(255, 255, 255, 0.84);
}

.brand-lockup,
.service-status,
.options-row,
.check-option,
.login-button,
.login-footer {
  display: flex;
  align-items: center;
}

.brand-lockup {
  gap: 14rpx;
}

.brand-logo {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.top-brand-name,
.top-brand-desc,
.eyebrow,
.editorial-title,
.editorial-summary,
.feature-index,
.feature-title,
.feature-desc,
.form-kicker,
.form-title,
.form-subtitle,
.field-label {
  display: block;
}

.top-brand-name {
  color: #20251f;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 600;
}

.top-brand-desc {
  margin-top: 5rpx;
  color: #7d837b;
  font-size: 17rpx;
}

.service-status {
  gap: 9rpx;
  color: #7a8178;
  font-size: 18rpx;
}

.status-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #4caf79;
  box-shadow: 0 0 0 7rpx #e6f4eb;
}

.login-shell {
  width: 100%;
  max-width: 1450rpx;
  margin: 0 auto;
  padding: 56rpx 24rpx 46rpx;
}

.editorial-panel {
  padding: 8rpx 2rpx 26rpx;
}

.eyebrow,
.form-kicker {
  color: #9b1f58;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.editorial-title {
  color: #1f251f;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 52rpx;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -1.4rpx;
}

.editorial-panel .eyebrow + .editorial-title {
  margin-top: 22rpx;
}

.editorial-summary {
  margin-top: 24rpx;
  max-width: 900rpx;
  color: #747b73;
  font-size: 21rpx;
  line-height: 1.75;
}

.feature-grid {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
}

.feature-card {
  padding: 20rpx;
  border: 1rpx solid #dfdcd5;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.7);
}

.feature-index {
  color: #a52762;
  font-family: Georgia, serif;
  font-size: 17rpx;
}

.feature-title {
  margin-top: 18rpx;
  color: #293029;
  font-size: 21rpx;
  font-weight: 650;
}

.feature-desc {
  margin-top: 7rpx;
  color: #858b83;
  font-size: 17rpx;
  line-height: 1.55;
}

.form-panel {
  padding-top: 10rpx;
}

.form-card {
  padding: 30rpx 24rpx 24rpx;
  border: 1rpx solid #ddd9d2;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(47, 43, 40, 0.07);
}

.form-title {
  margin-top: 14rpx;
  color: #222822;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 38rpx;
  font-weight: 600;
}

.form-subtitle {
  margin-top: 8rpx;
  color: #8a9088;
  font-size: 18rpx;
}

.auto-login-box {
  margin-top: 22rpx;
  padding: 15rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 16rpx;
  color: #6a7168;
  background: #f3f0eb;
  font-size: 18rpx;
}

.small-spinner {
  width: 23rpx;
  height: 23rpx;
  border: 3rpx solid #ded9d2;
  border-top-color: #9b1f58;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.form-group {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 9rpx;
  color: #4d554c;
  font-size: 18rpx;
  font-weight: 600;
}

.input-box {
  min-height: 70rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #dcd9d2;
  border-radius: 18rpx;
  background: #fbfaf7;
  transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
}

.input-box.focused {
  border-color: #b45982;
  background: #fff;
  box-shadow: 0 0 0 6rpx rgba(155, 31, 88, 0.06);
}

.field-input {
  flex: 1;
  height: 68rpx;
  color: #252b25;
  font-size: 21rpx;
}

.password-input {
  padding-right: 12rpx;
}

.password-toggle {
  padding: 16rpx 0 16rpx 14rpx;
  color: #9b1f58;
  font-size: 18rpx;
  font-weight: 600;
}

.options-row {
  margin-top: 19rpx;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
}

.check-option {
  gap: 9rpx;
  color: #727971;
  font-size: 18rpx;
}

.custom-check {
  width: 27rpx;
  height: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #cfcac3;
  border-radius: 8rpx;
  color: #fff;
  background: #fff;
  font-size: 17rpx;
}

.custom-check.checked {
  border-color: #9b1f58;
  background: #9b1f58;
}

.message-box {
  margin-top: 18rpx;
  padding: 15rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-radius: 15rpx;
  font-size: 18rpx;
}

.message-box.error {
  color: #aa3b44;
  background: #fff5f5;
  border: 1rpx solid #efd0d3;
}

.message-icon {
  width: 26rpx;
  height: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #b84851;
  font-weight: 700;
}

.login-button {
  margin-top: 24rpx;
  min-height: 70rpx;
  padding: 0 22rpx;
  justify-content: space-between;
  border-radius: 999rpx;
  color: #fff;
  background: #9b1f58;
  box-shadow: 0 10rpx 24rpx rgba(126, 29, 75, 0.16);
  font-size: 21rpx;
  font-weight: 650;
}

.login-button[disabled] {
  opacity: 0.55;
}

.button-arrow {
  font-size: 25rpx;
}

.register-line {
  margin-top: 20rpx;
  color: #858b83;
  font-size: 18rpx;
  text-align: center;
}

.register-link {
  margin-left: 8rpx;
  color: #9b1f58;
  font-weight: 650;
}

.login-footer {
  margin-top: 28rpx;
  justify-content: center;
  gap: 10rpx;
  color: #a0a59e;
  font-size: 14rpx;
}

.footer-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #bbbfb9;
}

@media (min-width: 800px) {
  .desktop-only-inline { display: inline-flex; }

  .login-topbar {
    min-height: 112rpx;
    padding: 22rpx 38rpx;
  }

  .brand-mark {
    width: 64rpx;
    height: 64rpx;
    border-radius: 19rpx;
    font-size: 37rpx;
  }

  .top-brand-name { font-size: 27rpx; }
  .top-brand-desc { font-size: 18rpx; }

  .login-shell {
    min-height: calc(100vh - 112rpx);
    padding: 72rpx 42rpx 52rpx;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(520rpx, 0.75fr);
    align-items: center;
    gap: 72rpx;
  }

  .editorial-panel {
    padding: 10rpx 0;
  }

  .editorial-title {
    font-size: 72rpx;
    line-height: 1.12;
    letter-spacing: -2rpx;
  }

  .editorial-summary {
    max-width: 920rpx;
    font-size: 22rpx;
  }

  .feature-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14rpx;
  }

  .feature-card {
    min-height: 150rpx;
    padding: 22rpx;
  }

  .form-panel {
    padding-top: 0;
  }

  .form-card {
    padding: 38rpx 36rpx 30rpx;
    border-radius: 32rpx;
  }
}
