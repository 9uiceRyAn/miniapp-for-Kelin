@import "../../styles/account.wxss";
@import "../../styles/workspace-motion.wxss";

.account-wechat {
  margin-top: 12px;
}

.account-wechat-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 44px;
  padding: 0 18px;
  border-radius: var(--ws-radius);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.5;
}

.account-wechat-status {
  display: block;
  margin-top: 6px;
  color: var(--ws-secondary);
  font-size: 12px;
  text-align: center;
}

.account-wechat-panel {
  margin-top: 18px;
  padding: 18px;
  border: 1px solid var(--ws-border);
  border-radius: var(--ws-radius);
  background: var(--ws-sidebar);
}

.account-wechat-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 16px;
}

.account-wechat-tab {
  margin: 0;
  padding: 9px 12px;
  min-height: 42px;
  border-radius: var(--ws-radius);
  border: 1px solid var(--ws-border);
  background: var(--ws-canvas);
  color: var(--ws-secondary);
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
}

.account-wechat-tab::after {
  border: 0;
}

.account-wechat-tab.active {
  border-color: var(--ws-accent);
  background: var(--ws-accent);
  color: var(--ws-on-accent);
}

.account-wechat-panel .account-roles {
  margin: 4px 0 18px;
}

.account-wechat-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 44px;
  margin-top: 8px;
  background: transparent;
  color: var(--ws-secondary);
  font-size: 13px;
  line-height: 1.4;
}
