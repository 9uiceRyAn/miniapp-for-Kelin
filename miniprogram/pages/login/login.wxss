@import "../../styles/account.wxss";
@import "../../styles/workspace-motion.wxss";

.account-wechat {
  margin-top: 12px;
}

.account-wechat-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 46px;
  padding: 0 18px;
  font-size: 14px;
  font-weight: 500;
  line-height: 1.5;
}

.account-wechat-status {
  display: block;
  margin-top: 6px;
  color: var(--ws-secondary);
  font-size: 12px;
  text-align: center;
}
