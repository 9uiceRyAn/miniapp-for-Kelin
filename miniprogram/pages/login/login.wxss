@import "../../styles/account.wxss";
@import "../../styles/workspace-motion.wxss";

.account-wechat {
  margin-top: 12px;
}

.account-wechat-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 46px;
  padding: 0 18px;
  font-size: 14px;
  font-weight: 500;
  line-height: 1.5;
}

.account-wechat-status {
  display: block;
  margin-top: 6px;
  color: var(--ws-secondary);
  font-size: 12px;
  text-align: center;
}

.login-page {
  padding-bottom: calc(28px + var(--login-bottom-inset));
  --login-bottom-inset: max(env(safe-area-inset-bottom, 0px), var(--ui-safe-bottom, 0px));
}

.login-page .safe-top {
  height: max(env(safe-area-inset-top, 0px), var(--ui-safe-top, 0px));
}

.account-wechat-panel {
  margin-top: 20px;
  padding: 16px;
  border: 1px solid var(--ws-border);
  border-radius: var(--ws-radius);
  background: var(--ws-sidebar);
}

.account-wechat-modes {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.account-wechat-mode,
.account-wechat-back {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin: 0;
  padding: 8px;
  font-size: 13px;
  line-height: 1.4;
  color: var(--ws-text);
}

.account-wechat-mode {
  width: 100%;
  border: 1px solid var(--ws-border);
  border-radius: var(--ws-radius);
  background: var(--ws-canvas);
}

.account-wechat-mode.selected {
  border-color: var(--ws-accent);
  background: var(--ws-accent);
  color: var(--ws-on-accent);
}

.account-wechat-panel .account-group { margin-top: 16px; }
.account-wechat-panel .account-submit { margin-top: 18px; }

.account-wechat-role {
  display: flex;
  min-height: 44px;
  margin-top: 12px;
  align-items: center;
  justify-content: space-between;
  font-size: 13px;
}

.account-wechat-back {
  width: 100%;
  margin-top: 6px;
  background: transparent;
  color: var(--ws-secondary);
}

@media (max-width: 700px) {
  .login-page .account-header { height: 56px; }
  .login-page .account-body { margin-top: 28px; }
}

@media (max-width: 700px) and (max-height: 650px) {
  .login-page .account-body { margin-top: 16px; }
  .login-page .account-group { margin-top: 16px; }
  .login-page .account-options { margin: 12px 0; }
  .login-page .account-submit { margin-top: 14px; }
}
