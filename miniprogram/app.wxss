page {
  min-height: 100%;
  background: #f7f6f2;
  color: #20251f;
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "SF Pro Text",
    "PingFang SC",
    "Helvetica Neue",
    "Microsoft YaHei",
    sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

button {
  margin: 0;
  line-height: 1;
}

.safe-top {
  height: env(safe-area-inset-top);
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
