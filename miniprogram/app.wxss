page {
  min-height: 100%;
  background: #ffffff;
  color: #202020;
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "SF Pro Text",
    "PingFang SC",
    "Helvetica Neue",
    "Microsoft YaHei",
    sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

button {
  margin: 0;
  line-height: 1;
}

.safe-top {
  height: env(safe-area-inset-top);
}
@media (max-width:700px) {
  .device-nav.workspace-shell {padding-top:var(--ws-safe-top,env(safe-area-inset-top));box-sizing:border-box}
  .device-nav.workspace-shell .workspace-header {box-sizing:border-box;min-height:44px;height:var(--nav-height,48px);padding:0 var(--nav-right,96px) 0 72px}
  .device-nav.workspace-shell .drawer-button {top:calc(var(--ws-safe-top,env(safe-area-inset-top)) + (var(--nav-height,48px) - 44px) / 2)}
  .device-nav.workspace-shell .workspace-sidebar {padding-top:var(--ws-safe-top,env(safe-area-inset-top))}
  .device-nav .workspace-sidebar .workspace-brand {min-height:var(--nav-height,48px);padding-right:var(--nav-right,16px)}
  .device-nav.account-page,.device-nav.learning-page {padding-top:var(--ws-safe-top,env(safe-area-inset-top))}
  .device-nav.account-page .account-header,.device-nav.learning-page>.nav,.device-nav.workspace-shell .detail-nav {min-height:var(--nav-height,48px);height:auto;box-sizing:border-box;padding-right:var(--nav-right,96px)}
}
.tab-library {width:19px;height:14px;margin-top:3px;border:1.5px solid currentColor;border-radius:3px;box-sizing:border-box}
.tab-library::before {content:"";position:absolute;left:0;top:-4px;width:8px;height:3px;border:1.5px solid currentColor;border-bottom:0;border-radius:2px 2px 0 0}
