.workspace-title{font-family:var(--ws-font);font-size:var(--ws-title-size);font-weight:600;display:block;line-height:1.3;letter-spacing:-.5px}.workspace-subtitle{color:var(--ws-secondary);font-size:13px;line-height:1.7;display:block;margin-top:10px}.heading-row{display:flex;align-items:center;justify-content:space-between;gap:18px}
.workspace-search{display:flex;align-items:center;gap:8px;min-height:44px;border:1px solid var(--ws-border);border-radius:var(--ws-radius);margin:20px 0 18px;padding:6px 6px 6px 14px;background:var(--ws-canvas);box-sizing:border-box}.workspace-search input{min-width:0;flex:1;border:0;background:transparent;margin:0;padding:0;font-size:14px;color:var(--ws-text);min-height:36px;height:36px;line-height:36px;text-align:left}.workspace-shell .workspace-search button,.workspace-search button{display:inline-flex;align-items:center;justify-content:center;text-align:center;height:34px;min-height:34px;line-height:1;padding:0 14px;font-size:12px;font-weight:500;border-radius:var(--ws-radius-sm);background:var(--ws-accent);color:var(--ws-on-accent);margin:0;flex-shrink:0}.workspace-search button::after{border:0}.workspace-label{font-size:11px;color:var(--ws-tertiary);display:block;margin-bottom:11px}.knowledge-tags{display:flex;flex-wrap:wrap;gap:7px;border-bottom:1px solid var(--ws-border);padding-bottom:23px}.workspace-shell .knowledge-tag{border:1px solid var(--ws-border);border-radius:22px;font-size:12px;padding:7px 13px;white-space:nowrap;color:var(--ws-secondary);flex-shrink:0}.workspace-shell .knowledge-tag.selected{background:var(--ws-accent);color:var(--ws-on-accent);border-color:var(--ws-accent)}.results-summary{display:flex;justify-content:space-between;font-size:11px;color:var(--ws-secondary);padding:21px 0 10px}.question-group{margin-top:18px}.group-heading{display:flex;align-items:center;gap:12px;font-weight:600;font-size:15px;margin-bottom:5px}.group-count{font-size:11px;color:var(--ws-secondary);font-weight:400}.question-row{display:flex;align-items:center;gap:14px;padding:16px 0;border-bottom:1px solid var(--ws-border)}.question-copy{flex:1;min-width:0}.question-title{display:block;font-size:15px;font-weight:500;line-height:1.5;color:var(--ws-text)}.question-meta{display:block;font-size:12px;line-height:1.6;color:var(--ws-secondary);margin-top:4px}.question-thumb{width:54px;height:65px;background:#fafafa;flex-shrink:0}.question-arrow{color:var(--ws-tertiary);font-size:18px}.advanced-filters{display:flex;flex-wrap:wrap;gap:10px;padding:14px;background:var(--ws-sidebar);border-radius:var(--ws-radius);margin-bottom:20px;font-size:12px}.workspace-shell .picker{font-size:12px;border-color:var(--ws-border);border-radius:var(--ws-radius);padding:10px;min-height:0}.workspace-shell .row{gap:10px}.workspace-shell .grid{grid-template-columns:1fr;gap:0}.workspace-shell .card{border-color:var(--ws-border);border-radius:var(--ws-radius);padding:20px;margin:16px 0}.workspace-shell .card-title{font-size:16px}.workspace-shell .sub{font-size:12px;color:var(--ws-secondary)}.workspace-shell button.primary{background:var(--ws-accent);color:var(--ws-on-accent)}.workspace-shell .badge{font-size:11px;background:var(--ws-muted);color:var(--ws-secondary);padding:3px 7px}.workspace-shell .back{color:var(--ws-secondary);font-size:13px!important}.workspace-shell .actions{gap:10px;margin:16px 0}.workspace-shell .actions button{background:var(--ws-muted)}.workspace-shell .actions button.primary{background:var(--ws-accent)}.workspace-shell .empty{color:var(--ws-tertiary);font-size:13px;padding:35px 10px}
.workspace-content.chat-landing{max-width:var(--ws-chat-width);min-height:calc(100% - var(--ws-header-height));display:flex;flex-direction:column;justify-content:center;padding-bottom:55px}.chat-welcome{text-align:center;margin-bottom:27px}.landing-composer{border:1px solid #dedede;border-radius:var(--ws-composer-radius);padding:17px 18px 12px;box-shadow:0 4px 16px #00000005}.workspace-shell .landing-composer textarea{border:0;width:100%;height:70px;min-height:70px;padding:0;margin:0;background:transparent;font-size:14px;line-height:1.7;color:var(--ws-text);box-sizing:border-box}.composer-tools{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px}.composer-tools-left{display:flex;align-items:center;gap:8px;min-width:0;flex:1}.landing-files{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}.landing-file-chip{display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:4px 10px;border:1px solid var(--ws-border);border-radius:14px;background:var(--ws-sidebar);font-size:12px;color:var(--ws-text)}.landing-file-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px}.landing-file-remove{color:var(--ws-secondary);padding:0 2px;font-size:14px;line-height:1}.agent-picker{min-width:0;max-width:calc(100% - 52px);flex:0 1 auto}.agent-choice{display:flex;align-items:center;gap:10px;height:36px;max-width:230px;padding:0 12px;border:1px solid var(--ws-border);border-radius:18px;background:var(--ws-sidebar);color:var(--ws-text);font-size:13px;font-weight:500;line-height:1;box-sizing:border-box}.agent-choice-name{display:block;flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.agent-choice-chevron{width:7px;height:7px;flex-shrink:0;margin-top:-4px;border-right:1.5px solid var(--ws-secondary);border-bottom:1.5px solid var(--ws-secondary);transform:rotate(45deg)}.agent-choice-pressed{background:var(--ws-muted)}.workspace-shell .send-button{width:35px;height:35px;flex-shrink:0;border-radius:50%;padding:0;display:inline-flex;align-items:center;justify-content:center;line-height:35px;text-align:center;background:var(--ws-accent);color:var(--ws-on-accent);font-size:22px}.workspace-shell .send-button[loading]::before,.workspace-shell .composer-send[loading]::before{margin-right:0}.chat-suggestions{display:flex;justify-content:center;gap:9px;margin-top:20px}.workspace-shell .chat-suggestions button{border:1px solid var(--ws-border);padding:8px 12px;font-size:11px;color:var(--ws-secondary)}
.workspace-content.chat-content{max-width:var(--ws-chat-width);padding-top:8px;padding-bottom:0;min-height:calc(100% - var(--ws-header-height));display:flex;flex-direction:column}.chat-content .nav{margin-bottom:15px}.chat-content .nav text{font-size:12px}.workspace-shell .message{font-size:14px;border-radius:15px;padding:18px 0;background:transparent;margin:8px 0;max-width:100%}.workspace-shell .message mp-html,.workspace-shell .message rich-text{display:block;white-space:normal}.workspace-shell .message.user{background:var(--ws-muted);padding:15px 18px;margin-left:15%}.workspace-shell .cite{border-color:var(--ws-border);background:var(--ws-sidebar);font-size:12px;padding:10px}.workspace-shell .conversation-composer{position:sticky;bottom:0;margin-top:auto;background:var(--ws-canvas);padding:15px 0 18px;border:0}.workspace-shell .conversation-composer textarea{border:1px solid var(--ws-border);border-radius:var(--ws-composer-radius);min-height:80px;height:80px;font-size:14px;padding:14px 16px;margin:6px 0}.conversation-composer .actions{margin:9px 0 0;justify-content:space-between}.workspace-shell .status{color:var(--ws-secondary);font-size:12px}.workspace-shell .error{font-size:13px;color:var(--ws-danger)}
@media(max-width:700px){.knowledge-tags{flex-wrap:nowrap;overflow-x:auto;white-space:nowrap;padding-bottom:18px}.workspace-subtitle{font-size:12px}.question-row{gap:10px;padding:16px 0}.question-title{font-size:14px}.question-meta{font-size:12px}.question-thumb{width:42px;height:55px}.workspace-shell .chat-suggestions button{font-size:10px}.workspace-shell .message{font-size:13px}.chat-content .nav{flex-wrap:wrap}.workspace-content.chat-landing{padding-bottom:30px}}

/* Agent role groups and nested recent conversations. */
.workspace-shell .agent-group-heading{display:flex;align-items:center;width:100%;gap:8px;padding:10px 12px;font-size:12px;font-weight:600}.agent-group-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.group-chevron{color:var(--ws-secondary);width:12px;font-size:16px}.agent-group-count{font-size:10px;color:var(--ws-tertiary);font-weight:400}.agent-conversation-list{margin-left:19px;border-left:1px solid var(--ws-border);padding-left:7px}.workspace-shell .agent-conversation-list .recent-item{font-size:11px;padding:9px 10px}.workspace-shell .recent-more{font-size:11px;color:var(--ws-secondary);padding:10px 13px}.workspace-main,.workspace-sidebar{scrollbar-width:thin}.knowledge-tags{scrollbar-width:none}.knowledge-tags::-webkit-scrollbar{display:none}

/* Dedicated library conversation; colors continue to inherit workspace tokens. */
.workspace-shell .library-welcome, .workspace-shell .library-action { padding: 14px; margin: 12px 0; border: 1px solid var(--ws-border); border-radius: var(--ws-radius); }
.workspace-shell .library-welcome text, .workspace-shell .library-action text { display: block; margin-bottom: 8px; }
.workspace-shell .library-action-text { white-space: pre-wrap; max-height: 200px; overflow-y: auto; }
