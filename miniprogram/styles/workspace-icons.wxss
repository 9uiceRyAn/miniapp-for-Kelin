/* Bottom tab bar icons */
.tab-icon {
  width: 20px;
  height: 20px;
  border: 0;
  border-radius: 0;
  margin: 0;
  flex-shrink: 0;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}
.tab-icon::before,
.tab-icon::after {
  content: none;
  display: none;
}

