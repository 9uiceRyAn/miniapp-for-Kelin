/* Profile hub icons */
.profile-glyph {
  width: 19px;
  height: 19px;
  flex-shrink: 0;
  border: 0;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}
.profile-glyph::before,
.profile-glyph::after,
.profile-exit-glyph::before,
.profile-exit-glyph::after {
  content: none;
  display: none;
}

