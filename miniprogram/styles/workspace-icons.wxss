/* Circular back button matching .drawer-button */
.workspace-shell .header-back,
.workspace-shell .detail-back,
.account-page .account-back {
  width: 44px;
  height: 44px;
  min-height: 44px;
  padding: 0;
  margin: 0;
  border: 1px solid var(--ws-border);
  border-radius: 50%;
  background: var(--ws-canvas);
  color: var(--ws-text);
  box-shadow: 0 3px 14px #00000012;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}
.workspace-shell .header-back::after,
.workspace-shell .detail-back::after,
.account-page .account-back::after {
  border: 0;
}
