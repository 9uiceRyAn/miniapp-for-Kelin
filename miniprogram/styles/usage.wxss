.usage-dashboard{padding-top:10px}.usage-subtitle{display:block;font-size:13px;color:var(--ws-secondary);line-height:1.7;margin:0 0 22px}
.usage-scopes{display:flex;background:var(--ws-sidebar);border-radius:var(--ws-radius);padding:4px;gap:4px}.workspace-shell .usage-scope{flex:1;text-align:center;padding:10px 8px;font-size:12px;color:var(--ws-secondary);border-radius:var(--ws-radius-sm);white-space:nowrap}.workspace-shell .usage-scope.is-selected{background:var(--ws-accent);box-shadow:none;color:var(--ws-on-accent);font-weight:500}
.usage-period-row{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--ws-secondary);margin:20px 0 12px;gap:12px}
.usage-filter-panel{padding:18px;background:var(--ws-sidebar);border-radius:12px;margin:0 0 18px;animation:workspace-enter 180ms ease-out both}.usage-date-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.usage-field-label{display:block;font-size:11px;color:var(--ws-secondary);margin-bottom:7px}.usage-date-value{background:var(--ws-canvas);border:1px solid var(--ws-border);border-radius:var(--ws-radius);min-height:44px;padding:11px;font-size:12px;display:flex;align-items:center}.usage-time-note{display:block;font-size:10px;color:var(--ws-secondary);margin-top:12px}.workspace-shell .usage-user-filter{background:var(--ws-canvas);border:1px solid var(--ws-border);border-radius:var(--ws-radius);padding:0 12px;font-size:13px;margin:0 0 8px;min-height:44px;height:44px}.usage-filter-panel>.usage-date-fields+view{margin-top:15px}.usage-filter-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:15px}.workspace-shell .usage-filter-actions button{font-size:12px;padding:9px 14px}
.usage-overview{border:1px solid var(--ws-border);border-radius:16px;padding:22px 22px 16px;background:var(--ws-canvas)}.usage-overview-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:13px;font-weight:500}.usage-overview-heading text:last-child{font-size:10px;color:var(--ws-secondary);font-weight:400}.usage-currencies{display:flex;flex-wrap:wrap;gap:22px;padding:23px 0}.usage-currency{flex:1;min-width:160px}.usage-amount-line{display:flex;gap:9px;align-items:baseline;flex-wrap:wrap}.usage-amount{font-size:34px;line-height:1.2;letter-spacing:-.7px;font-weight:600;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.usage-currency-code{font-size:12px;color:var(--ws-secondary)}.usage-estimated-calls{display:block;font-size:11px;color:var(--ws-secondary);margin-top:10px}.usage-total-line{display:flex;justify-content:space-between;gap:10px;border-top:1px solid var(--ws-border);padding-top:14px;font-size:11px;color:var(--ws-secondary)}.usage-total-line text:last-child{font-size:10px}.usage-no-estimate{padding:24px 0;color:var(--ws-secondary);font-size:21px}
.usage-pending-note{display:flex;gap:10px;padding:17px 4px 18px;align-items:flex-start}.usage-pending-dot{width:6px;height:6px;border-radius:50%;background:#a08342;flex-shrink:0;margin-top:7px}.usage-pending-title{font-size:12px;font-weight:500;display:block;color:#685a3c}.usage-pending-description{display:block;font-size:11px;color:var(--ws-secondary);line-height:1.8;margin-top:4px}
.usage-list-heading{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-top:22px;padding-bottom:8px;font-size:15px;font-weight:500}.usage-list-heading text:last-child{font-size:10px;color:var(--ws-secondary);font-weight:400}.usage-row{border-bottom:1px solid var(--ws-border)}.workspace-shell .usage-row-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;width:100%;background:transparent;padding:16px 0;margin:0;border-radius:0;text-align:left}.usage-row-copy{min-width:0;flex:1}.usage-purpose{display:block;font-size:15px;font-weight:500;color:var(--ws-text)}.usage-model{display:block;font-size:12px;color:var(--ws-secondary);overflow:hidden;white-space:nowrap;text-overflow:ellipsis;margin-top:7px;line-height:1.7}.usage-time{display:block;font-size:10px;color:var(--ws-secondary);margin-top:5px;line-height:1.7}.usage-row-cost{text-align:right;max-width:44%;font-variant-numeric:tabular-nums}.usage-row-amount{display:block;font-size:13px;color:var(--ws-text);line-height:1.6;overflow-wrap:anywhere}.usage-row-pending{display:block;font-size:12px;color:var(--ws-secondary)}.usage-status{display:block;font-size:10px;color:var(--ws-secondary);margin-top:5px}.usage-row-chevron{display:block;font-size:14px;color:var(--ws-secondary);margin-top:5px}
.usage-record-detail{padding:16px;background:var(--ws-sidebar);border-radius:10px;margin-bottom:17px;animation:workspace-enter 160ms ease-out both}.usage-detail-explanation{display:block;font-size:12px;line-height:1.7;color:var(--ws-secondary)}.usage-token-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px}.usage-token-grid text{display:block;font-size:10px;color:var(--ws-secondary);overflow-wrap:anywhere}.usage-token-grid text:last-child{font-size:13px;color:var(--ws-text);margin-top:7px}.usage-detail-model{display:block;color:var(--ws-secondary);font-size:10px;margin-top:18px;line-height:1.7;overflow-wrap:anywhere}
@media(min-width:900px){.usage-dashboard{max-width:860px}.usage-scopes{max-width:430px}.usage-amount{font-size:38px}.usage-overview{padding:26px}.usage-row-head{gap:30px}.usage-model{font-size:12px}.usage-row-amount{font-size:14px}}
@media(max-width:700px){.usage-amount{font-size:30px}.usage-overview{padding:20px 18px 16px}.usage-row-head{gap:14px}.usage-currencies{padding:22px 0}.usage-scope{font-size:11px}.usage-time{font-size:10px}}
@media(prefers-reduced-motion:reduce){.usage-filter-panel,.usage-record-detail{animation:none}}

.usage-cny-total{padding-top:22px}.usage-cny-label{display:block;font-size:11px;color:var(--ws-secondary);margin-bottom:9px}.usage-cny-total+.usage-currencies{border-top:1px solid var(--ws-border);margin-top:22px}.usage-cny-total+.usage-currencies .usage-amount{font-size:22px;letter-spacing:0}.usage-cny-equivalent,.usage-row-cny{display:block;font-size:11px;color:var(--ws-secondary);margin-top:6px;line-height:1.7;overflow-wrap:anywhere}.usage-exchange-note,.usage-cny-excluded{display:block;font-size:10px;color:var(--ws-secondary);line-height:1.8;margin-bottom:14px}.usage-cny-excluded{margin-top:10px}.usage-row-cny{font-size:10px}
