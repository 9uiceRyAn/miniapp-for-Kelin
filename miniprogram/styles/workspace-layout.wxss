/* Shared desktop/mobile shell. Keep viewport and navigation geometry here. */
.workspace-shell{position:relative;height:100vh;height:100dvh;display:grid;grid-template-columns:var(--ws-sidebar-width) minmax(0,1fr);grid-template-rows:minmax(0,1fr) calc(var(--ws-bottom-height) + env(safe-area-inset-bottom));color:var(--ws-text);background:var(--ws-canvas);font-family:var(--ws-font);font-size:var(--ws-text-size);box-sizing:border-box}
.workspace-shell view,.workspace-shell button,.workspace-shell input,.workspace-shell textarea{box-sizing:border-box}
.workspace-shell button{font-family:var(--ws-font);font-size:13px;border:0;border-radius:var(--ws-radius);margin:0;background:transparent;color:inherit;line-height:1.5;padding:10px 14px;font-weight:400;text-align:left}
.workspace-shell button::after{border:0}.workspace-shell button[disabled]{opacity:.4}
.workspace-sidebar{background:var(--ws-sidebar);padding:24px 15px 16px;display:flex;flex-direction:column;overflow-y:auto;min-height:0;border-right:1px solid var(--ws-border)}
.workspace-brand{display:flex;gap:10px;align-items:center;font-size:17px;font-weight:600;letter-spacing:2px;padding:0 13px 5px}.brand-symbol{height:29px;width:29px;display:flex;align-items:center;justify-content:center;background:var(--ws-accent);color:var(--ws-on-accent);border-radius:9px;font-size:18px;letter-spacing:0}
.workspace-shell .sidebar-close{display:none}.sidebar-label{display:block;color:var(--ws-tertiary);font-size:11px;padding:26px 13px 10px}.workspace-shell .sidebar-item{width:100%;display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;color:var(--ws-secondary);margin:2px 0;padding:11px 13px;font-size:13px}.workspace-shell .sidebar-item.selected{background:var(--ws-selected);color:var(--ws-text);font-weight:600}.side-arrow{color:var(--ws-tertiary);font-size:16px}.workspace-shell .recent-item{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;display:block;font-size:12px}.sidebar-note{font-size:11px;color:var(--ws-tertiary);padding:10px 13px}
.workspace-main{min-width:0;min-height:0;overflow:auto}.workspace-header{height:var(--ws-header-height);padding:0 32px;display:flex;align-items:center;justify-content:space-between;gap:14px;font-size:12px;color:var(--ws-secondary)}.header-start{display:flex;align-items:center;gap:12px;min-width:0}.header-start>text{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.workspace-shell .header-back{width:44px;height:44px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;padding:0;margin:0;border:1px solid var(--ws-border);border-radius:50%;background:var(--ws-canvas);color:var(--ws-text);box-shadow:0 3px 14px #00000012;flex-shrink:0}.breadcrumb{color:var(--ws-tertiary);font-size:12px}.header-account{max-width:140px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.workspace-shell .drawer-button{display:none;padding:6px;font-size:18px}.workspace-content{max-width:var(--ws-content-width);margin:auto;padding:30px var(--ws-page-gutter) 40px}
.workspace-bottom{grid-column:1/-1;border-top:1px solid var(--ws-border);background:var(--ws-canvas);display:flex;align-items:center;justify-content:center;gap:35px;padding:9px 20px calc(9px + env(safe-area-inset-bottom));z-index:20}.workspace-shell .bottom-item{width:150px;display:flex;align-items:center;justify-content:center;gap:10px;color:var(--ws-tertiary);padding:11px}.workspace-shell .bottom-item.selected{color:var(--ws-text);background:var(--ws-muted);font-weight:600}.workspace-scrim{display:none}
@media(max-width:700px){.workspace-shell{grid-template-columns:minmax(0,1fr)}.workspace-sidebar{display:none;position:absolute;left:0;top:0;bottom:calc(var(--ws-bottom-height) + env(safe-area-inset-bottom));width:260px;z-index:32;box-shadow:6px 0 40px #00000018}.workspace-sidebar.is-open{display:flex}.workspace-shell .sidebar-close{display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-left:auto;width:44px;height:44px;min-height:44px;padding:0;border-radius:50%;font-size:22px;line-height:1;color:var(--ws-secondary);background:transparent}.workspace-scrim{display:block;position:absolute;inset:0 0 calc(var(--ws-bottom-height) + env(safe-area-inset-bottom)) 0;background:#00000055;z-index:30}.workspace-shell .drawer-button{position:fixed;top:calc(var(--ws-safe-top, env(safe-area-inset-top)) + 8px);left:16px;z-index:29;width:44px;height:44px;min-height:44px;padding:0;display:flex;align-items:center;justify-content:center;border:1px solid var(--ws-border);border-radius:50%;background:var(--ws-canvas);color:var(--ws-text);box-shadow:0 3px 14px #00000012;font-size:20px;line-height:1;text-align:center;transform:translateZ(0);backface-visibility:hidden;contain:layout style paint}.workspace-shell .drawer-button.is-behind{pointer-events:none}.workspace-sidebar{padding-top:calc(var(--ws-safe-top, env(safe-area-inset-top)) + 8px)}.workspace-sidebar .workspace-brand{padding-right:0}.workspace-header{height:calc(var(--ws-header-height) + var(--ws-safe-top, env(safe-area-inset-top)));padding:var(--ws-safe-top, env(safe-area-inset-top)) 17px 0 76px}.workspace-content{padding-top:22px}.workspace-bottom{gap:6px;padding:7px 15px calc(7px + env(safe-area-inset-bottom))}.workspace-shell .bottom-item{flex:1;flex-direction:column;gap:5px;font-size:10px;padding:8px}.header-account{max-width:90px}.workspace-shell .brand-symbol{flex-shrink:0}}
