page{background:#f7f6f2;color:#20251f}.learning-page{padding:32rpx;max-width:1200px;margin:auto;padding-top:calc(env(safe-area-inset-top) + 24rpx)}.nav{display:flex;align-items:center;gap:24rpx;margin-bottom:32rpx}.nav text{font-size:32rpx}.back{color:#9b1f58;font-size:28rpx!important}.title{font-family:Georgia,"Songti SC",serif;font-size:46rpx;display:block;margin-bottom:12rpx}.sub,.muted{font-size:24rpx;color:#74786f;white-space:pre-wrap;line-height:1.6}.tabs{display:flex;gap:16rpx;margin:28rpx 0;flex-wrap:wrap}.tabs button,.chip{padding:18rpx 26rpx;background:#eeeae3;color:#34392f;border-radius:10rpx;font-size:26rpx}.tabs .active,button.primary{background:#9b1f58;color:white}.card{padding:28rpx;background:#fff;border:1px solid #e6e3dc;border-radius:16rpx;margin:20rpx 0;overflow:hidden}.card-title{font-size:32rpx;display:block;margin-bottom:12rpx;font-weight:600}.row{display:flex;gap:20rpx;align-items:center;flex-wrap:wrap}.row .grow{flex:1;min-width:220rpx}.thumb{width:130rpx;height:150rpx;flex-shrink:0;background:#f4f2ed}.filters{display:flex;gap:16rpx;flex-wrap:wrap;margin:20rpx 0}input,textarea,.picker{background:#fff;border:1px solid #d8d7cf;border-radius:10rpx;padding:22rpx;font-size:28rpx;min-height:80rpx}input{box-sizing:border-box;width:100%;margin:12rpx 0}.picker{font-size:26rpx}textarea{width:100%;box-sizing:border-box;min-height:260rpx;line-height:1.6;margin:18rpx 0}button{font-size:26rpx;padding:22rpx 28rpx;background:#eeeae3;border-radius:10rpx;line-height:1.2;margin:8rpx 0}button.danger{color:#a12540}.actions{display:flex;gap:16rpx;flex-wrap:wrap;margin:24rpx 0}.error{color:#a12540;padding:20rpx;white-space:pre-wrap}.badge{display:inline-block;font-size:22rpx;padding:6rpx 12rpx;background:#f1e8ec;color:#9b1f58;border-radius:6rpx;margin-right:8rpx}.empty{padding:60rpx 20rpx;text-align:center;color:#74786f}.full-image{width:100%;display:block;margin:16rpx 0}.message{padding:24rpx;background:#fff;border-radius:16rpx;margin:20rpx 0;line-height:1.8;overflow-wrap:anywhere;white-space:pre-wrap}.message.user{background:#f0e5e9;margin-left:40rpx}.message .speaker{display:block;font-size:22rpx;color:#74786f;margin-bottom:12rpx}.cite{border-left:4rpx solid #9b1f58;padding:16rpx;background:#f7f6f2;margin-top:20rpx;font-size:24rpx}.composer{position:sticky;bottom:0;background:#f7f6f2;padding:16rpx 0 calc(env(safe-area-inset-bottom) + 16rpx);border-top:1px solid #dedbd4}.composer textarea{min-height:130rpx;max-height:280rpx}.label{display:block;font-size:26rpx;margin-top:20rpx}.status{font-size:24rpx;color:#9b1f58;padding:12rpx}.grid{display:grid;grid-template-columns:1fr;gap:20rpx}@media(min-width:800px){.learning-page{padding:40px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.message{max-width:900px}.composer{max-width:1000px}.full-image{max-width:1000px}}
