@import "./workspace-tokens.wxss";
page{background:var(--ws-canvas);color:var(--ws-text);font-family:var(--ws-font)}
.learning-page{padding:calc(env(safe-area-inset-top) + 24px) 24px 40px;max-width:1100px;margin:auto;font-size:14px;box-sizing:border-box}
.nav{display:flex;align-items:center;gap:18px;margin-bottom:34px;min-height:36px;font-size:13px}.nav text{font-size:14px}.nav .back{color:var(--ws-secondary);font-size:13px!important}.nav button{margin-left:auto}
.title{font-family:var(--ws-font);font-size:28px;font-weight:600;display:block;margin-bottom:12px;line-height:1.4;letter-spacing:-.5px}.sub{font-size:12px;color:var(--ws-secondary);white-space:pre-wrap;line-height:1.8}button.primary{background:var(--ws-accent);color:var(--ws-on-accent)}
.card{padding:24px;background:var(--ws-canvas);border:1px solid var(--ws-border);border-radius:var(--ws-radius);margin:22px 0;overflow:hidden}.card-title{font-size:16px;display:block;margin-bottom:14px;font-weight:500;line-height:1.5}.row{display:flex;gap:14px;align-items:center;flex-wrap:wrap}.row .grow{flex:1;min-width:180px}.thumb{width:90px;height:105px;flex-shrink:0;background:var(--ws-sidebar)}
input,textarea,.picker{background:var(--ws-canvas);border:1px solid var(--ws-border);border-radius:var(--ws-radius);padding:12px 14px;font-size:14px;min-height:44px;color:var(--ws-text)}input{box-sizing:border-box;width:100%;margin:12px 0}.picker{font-size:13px}textarea{width:100%;box-sizing:border-box;min-height:180px;line-height:1.8;margin:18px 0}
button{font-family:var(--ws-font);font-size:13px;padding:11px 15px;background:var(--ws-muted);border-radius:var(--ws-radius);line-height:1.5;margin:8px 0;color:var(--ws-text)}button[disabled]{opacity:.45}button.danger{color:var(--ws-danger)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}.error{color:var(--ws-danger);padding:14px 0;white-space:pre-wrap;font-size:13px}.badge{display:inline-block;font-size:11px;padding:4px 8px;background:var(--ws-muted);color:var(--ws-secondary);border-radius:5px;margin-right:6px}.empty{padding:50px 20px;text-align:center;color:var(--ws-secondary)}
.message{padding:18px;background:var(--ws-canvas);border-radius:var(--ws-radius);margin:18px 0;line-height:1.8;overflow-wrap:anywhere;white-space:pre-wrap}.message.user{background:var(--ws-muted);margin-left:24px}.message .speaker{display:block;font-size:11px;color:var(--ws-secondary);margin-bottom:10px}.cite{border-left:2px solid var(--ws-border);padding:14px;background:var(--ws-sidebar);margin-top:18px;font-size:12px}.composer{position:sticky;bottom:0;background:var(--ws-canvas);padding:16px 0 calc(env(safe-area-inset-bottom) + 16px);border-top:1px solid var(--ws-border)}.composer textarea{min-height:100px;max-height:200px}.label{display:block;font-size:13px;margin-top:20px}.status{font-size:12px;color:var(--ws-secondary);padding:12px}.grid{display:grid;grid-template-columns:1fr;gap:20px}
@media(min-width:900px){.learning-page{padding:40px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.grid>.card{margin:0}.message{max-width:900px}.composer{max-width:1000px}}
