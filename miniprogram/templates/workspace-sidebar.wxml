<view class="workspace-scrim {{drawerOpen?'is-open':''}}" aria-hidden="{{!drawerOpen}}" bindtap="closeDrawer" aria-label="关闭侧栏"/>
<view class="workspace-sidebar {{drawerOpen?'is-open':''}}">
 <view class="workspace-brand"><text class="brand-symbol">C</text><text>COLLINS</text><button hover-class="motion-pressed" hover-stay-time="70" class="sidebar-close" bindtap="closeDrawer" aria-label="关闭侧栏">×</button></view>
 <block wx:if="{{mainTab==='bank'}}"><text class="sidebar-label">学科</text><button hover-class="motion-pressed" hover-stay-time="70" wx:for="{{subjects}}" wx:key="id" class="sidebar-item {{subject===item.id?'selected':''}}" data-index="{{index}}" bindtap="selectSubject"><text>{{item.label}}</text><text class="side-arrow">›</text></button></block>
 <block wx:elif="{{mainTab==='chat'}}"><text class="sidebar-label">学习助手</text><button hover-class="motion-pressed" hover-stay-time="70" class="sidebar-item {{section==='agents'?'selected':''}}" data-id="agents" bindtap="selectSection">＋ 新对话</button><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{teacher}}" class="sidebar-item" data-id="library" bindtap="selectSection">教学资料管家</button><text class="sidebar-label">最近会话</text><view class="agent-conversation-group" wx:for="{{conversationGroups}}" wx:key="id" wx:for-item="group"><button hover-class="motion-pressed" hover-stay-time="70" class="agent-group-heading" data-id="{{group.id}}" bindtap="toggleAgentGroup" aria-expanded="{{group.expanded}}"><text class="group-chevron">{{group.expanded?'⌄':'›'}}</text><text class="agent-group-name">{{group.label}}</text><text class="agent-group-count">{{group.items.length}}</text></button><view wx:if="{{group.expanded}}" class="agent-conversation-list"><button hover-class="motion-pressed" hover-stay-time="70" wx:for="{{group.items}}" wx:key="id" class="sidebar-item recent-item {{id===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="conversation">{{item.displayTitle}}</button></view></view><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{recentHasMore}}" class="recent-more" bindtap="moreRecent" loading="{{recentLoading}}">加载更早会话</button><text wx:if="{{!recentConversations.length}}" class="sidebar-note">还没有会话</text></block>
 <block wx:else><text class="sidebar-label">我的空间</text><button hover-class="motion-pressed" hover-stay-time="70" class="sidebar-item {{section==='profile'?'selected':''}}" data-id="profile" bindtap="selectSection">个人中心</button><button hover-class="motion-pressed" hover-stay-time="70" class="sidebar-item {{section==='library'?'selected':''}}" data-id="library" bindtap="selectSection">{{teacher?'教学资料管家':'公共教学资料'}}</button><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{teacher}}" class="sidebar-item {{section==='teacher'?'selected':''}}" data-id="teacher" bindtap="selectSection">我的教学助手</button><button hover-class="motion-pressed" hover-stay-time="70" class="sidebar-item {{section==='usage'?'selected':''}}" data-id="usage" bindtap="selectSection">用量与费用</button><button hover-class="motion-pressed" hover-stay-time="70" wx:if="{{admin}}" class="sidebar-item" bindtap="openAdmin">平台管理</button></block>
 <view wx:if="{{admin}}" class="sidebar-footer"><text class="sidebar-home" bindtap="home">题库管理 ↗</text></view>
</view>
