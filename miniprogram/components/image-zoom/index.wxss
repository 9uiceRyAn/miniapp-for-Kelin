.image-zoom{position:fixed;inset:0;z-index:100;background:#111;color:#fff;display:flex;flex-direction:column;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;box-sizing:border-box}.image-zoom-header{display:flex;align-items:center;gap:12px;flex-shrink:0;min-height:60px;padding:calc(var(--zoom-safe-top,0px) + 8px) 105px 8px 16px;box-sizing:border-box}.image-zoom-title{display:block;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:13px;color:#ddd}.image-zoom button{display:flex;align-items:center;justify-content:center;margin:0;padding:0;width:44px;height:44px;min-height:44px;flex-shrink:0;border:0;border-radius:50%;line-height:1;background:#ffffff14;color:#fff;font-size:25px;box-sizing:border-box}.image-zoom button::after{border:0}.image-zoom button[disabled]{opacity:.3}.image-zoom .image-zoom-close{background:transparent;font-size:29px}.image-zoom-stage{display:block;flex:1;width:100%;height:0;min-height:0;overflow:hidden}.image-zoom-picture{display:block;box-sizing:border-box}.image-zoom-image{display:block;width:100%;height:100%}.image-zoom-footer{flex-shrink:0;padding:14px 16px calc(14px + env(safe-area-inset-bottom));box-sizing:border-box}.image-zoom-controls,.image-zoom-gallery{display:flex;align-items:center;justify-content:center;gap:12px}.image-zoom-percent{width:52px;text-align:center;font-size:13px;font-variant-numeric:tabular-nums}.image-zoom .image-zoom-reset{width:64px;border-radius:22px;margin-left:8px;font-size:12px}.image-zoom-gallery{margin-top:9px;font-size:12px;color:#ccc}.image-zoom-gallery button{width:44px;height:44px;min-height:44px;font-size:25px;background:transparent}.image-zoom-hint{display:block;text-align:center;font-size:11px;color:#aaa;margin-top:12px}.image-zoom-error{position:absolute;top:48%;left:20px;right:20px;text-align:center;font-size:13px;color:#ddd}
