<view class="image-zoom" style="--zoom-safe-top:{{safeTop}}px">
 <view class="image-zoom-header"><button class="image-zoom-close" bindtap="close" aria-label="关闭图片预览">×</button><text class="image-zoom-title">{{label}}</text></view>
 <movable-area class="image-zoom-stage" scale-area="{{true}}">
  <movable-view class="image-zoom-picture" style="width:{{imageWidth}}px;height:{{imageHeight}}px" direction="all" x="{{x}}" y="{{y}}" scale="{{true}}" scale-min="1" scale-max="6" scale-value="{{zoom}}" animation="{{false}}" bindscale="scaleChanged" bindchange="moved">
   <image wx:for="{{activeImage}}" wx:key="request" class="image-zoom-image" src="{{item.url}}" mode="aspectFit" data-request="{{item.request}}" bindload="imageLoaded" binderror="imageFailed"/>
  </movable-view>
 </movable-area>
 <text wx:if="{{error}}" class="image-zoom-error">{{error}}</text>
 <view class="image-zoom-footer">
  <view class="image-zoom-controls"><button class="image-zoom-minus" data-step="-0.5" bindtap="zoomBy" disabled="{{!ready||zoom<=1}}" aria-label="缩小图片">−</button><text class="image-zoom-percent">{{percent}}%</text><button class="image-zoom-plus" data-step="0.5" bindtap="zoomBy" disabled="{{!ready||zoom>=6}}" aria-label="放大图片">＋</button><button class="image-zoom-reset" bindtap="reset" disabled="{{!ready}}" aria-label="复位并适应屏幕">复位</button></view>
  <view class="image-zoom-gallery" wx:if="{{images.length>1}}"><button class="image-zoom-previous" bindtap="previous" disabled="{{currentIndex===0}}" aria-label="上一张图片">‹</button><text>{{currentIndex+1}} / {{images.length}}</text><button class="image-zoom-next" bindtap="next" disabled="{{currentIndex===images.length-1}}" aria-label="下一张图片">›</button></view>
  <text class="image-zoom-hint">双指缩放 · 拖动查看</text>
 </view>
</view>
