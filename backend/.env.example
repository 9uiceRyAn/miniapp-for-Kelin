PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fileapp
DB_PASSWORD=CHANGE_ME
DB_NAME=file_manager
UPLOAD_ROOT=/var/www/file-manager/uploads/files
MAX_UPLOAD_MB=200
SESSION_TTL_HOURS=12
REMEMBER_DEVICE_DAYS=30
# Generate once and keep stable (32 random bytes, hex encoded).
REGISTRATION_CODE_KEY=

# Learning platform: keep keys on the server; use a different random media signing key.
LEARNING_STORAGE_ROOT=/var/www/file-manager/uploads/learning
MEDIA_SIGNING_KEY=CHANGE_ME
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MODEL_ADMIN_KEY=CHANGE_ME
LITELLM_CALL_KEY=CHANGE_ME
# Optional initial defaults; the administrator can select these from the mini program.
BUILDER_MODEL_ID=
VISION_MODEL_ID=
# Self-hosted free web search via SearXNG (see backend/searxng/docker-compose.yml)
# Set after starting the local search service, e.g. http://127.0.0.1:8080
SEARXNG_BASE_URL=
SEARXNG_ENGINES=bing,baidu
SEARXNG_LANGUAGE=zh-CN
# Optional paid fallback if SearXNG is not used:
TAVILY_API_KEY=
MAX_DOCUMENT_MB=30
MAX_DOCUMENT_PAGES=100

WECHAT_MINI_APP_ID=wx9fdf87328fd6779d
WECHAT_MINI_APP_SECRET=
