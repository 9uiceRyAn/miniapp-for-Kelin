[Unit]
Description=Kelin scoped learning model gateway
After=network-online.target
[Service]
DynamicUser=yes
User=kelin-gateway
WorkingDirectory=/opt/kelin-model-gateway
EnvironmentFile=/etc/kelin-model-gateway/keys.env
Environment=CONFIG_FILE_PATH=/opt/kelin-model-gateway/config.yaml
Environment=LITELLM_LOCAL_MODEL_COST_MAP=True
Environment=HOME=/var/cache/kelin-model-gateway
CacheDirectory=kelin-model-gateway
ExecStart=/opt/kelin-model-gateway/venv/bin/python -m uvicorn gateway_entry:app --host 127.0.0.1 --port 4000 --no-access-log
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
